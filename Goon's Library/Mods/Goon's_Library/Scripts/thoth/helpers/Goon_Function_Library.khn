-- ==================================== "SpellDamageTypeIs" "DamageTypes" checks
-- Functions for "SpellDamageTypeIs" "DamageTypes" checks, not to be confused with damage dealt.
-- TODO: Support spell damage type transmutation.

function Goon_IsSpellWithoutDamageType()
    return ~Goon_IsSpellDamageTypeAcid()
         & ~Goon_IsSpellDamageTypeCold()
         & ~Goon_IsSpellDamageTypeFire()
         & ~Goon_IsSpellDamageTypeLightning()
         & ~Goon_IsSpellDamageTypeThunder()
         & ~Goon_IsSpellDamageTypeRadiant()
         & ~Goon_IsSpellDamageTypePoison()
         & ~Goon_IsSpellDamageTypePsychic()
         & ~Goon_IsSpellDamageTypeNecrotic()
         & ~Goon_IsSpellDamageTypeForce()
         & ~Goon_IsSpellDamageTypeSlashing()
         & ~Goon_IsSpellDamageTypePiercing()
         & ~Goon_IsSpellDamageTypeBludgeoning()
end

function Goon_IsSpellDamageTypeElemental()
    return Goon_IsSpellDamageTypeAcid()
         | Goon_IsSpellDamageTypeCold()
         | Goon_IsSpellDamageTypeFire()
         | Goon_IsSpellDamageTypeLightning()
         | Goon_IsSpellDamageTypeThunder()
end

function Goon_IsSpellDamageTypeAcid()
    return SpellDamageTypeIs(DamageType.Acid)
end

function Goon_IsSpellDamageTypeCold()
    return SpellDamageTypeIs(DamageType.Cold)
end

function Goon_IsSpellDamageTypeFire()
    return SpellDamageTypeIs(DamageType.Fire)
end

function Goon_IsSpellDamageTypeLightning()
    return SpellDamageTypeIs(DamageType.Lightning)
end

function Goon_IsSpellDamageTypeThunder()
    return SpellDamageTypeIs(DamageType.Thunder)
end

function Goon_IsSpellDamageTypeRadiant()
    return SpellDamageTypeIs(DamageType.Radiant)
end

function Goon_IsSpellDamageTypePoison()
    return SpellDamageTypeIs(DamageType.Poison)
end

function Goon_IsSpellDamageTypePsychic()
    return SpellDamageTypeIs(DamageType.Psychic)
end

function Goon_IsSpellDamageTypeNecrotic()
    return SpellDamageTypeIs(DamageType.Necrotic)
end

function Goon_IsSpellDamageTypeForce()
    return SpellDamageTypeIs(DamageType.Force)
end

function Goon_IsSpellDamageTypeSlashing()
    return SpellDamageTypeIs(DamageType.Slashing)
end

function Goon_IsSpellDamageTypePiercing()
    return SpellDamageTypeIs(DamageType.Piercing)
end

function Goon_IsSpellDamageTypeBludgeoning()
    return SpellDamageTypeIs(DamageType.Bludgeoning)
end

-- ==================================== Weapon/armour equipped checks ====================================

function Goon_Dueling_Check(entity)
    entity = entity or context.Target
    local hasNonVersatileWeapon = WieldingWeapon('Melee', false, true, entity) & ~WieldingWeapon('Versatile', false, true, entity) & ~WieldingWeapon('Twohanded', false, true, entity) & ~WieldingWeapon('Melee', true, true, entity)
    local hasVersatileWeapon = WieldingWeapon('Versatile', false, true, entity) & WieldingWeapon('Melee', false, true, entity) & HasShieldEquipped(entity)
    return hasNonVersatileWeapon | hasVersatileWeapon
end

-- This is exact same as the vanilla DualWielder() khn function but putting this here for completeness
function Goon_DualWielding_Check(entity)
    entity = entity or context.Target
    return WieldingWeapon('Melee', false, true, entity) & WieldingWeapon('Melee', true, true, entity)
end

function Goon_GreatWeapon_Check(entity)
    entity = entity or context.Target
    local hasTwohandedWeapon = WieldingWeapon('Twohanded', false, true, entity) & WieldingWeapon('Melee', false, true, entity)
    local hasVersatileWeapon = WieldingWeapon('Versatile', false, true, entity) & ~WieldingWeapon('Melee', true, true, entity) & ~HasShieldEquipped(entity)
    return hasTwohandedWeapon | hasVersatileWeapon
end

-- Use in conjunction with Goon_IsPolearm() check (which only checks the active weapon) to reasonably cover all polearm-wielding possibilities for NPCs at least
function Goon_Polearm_Check(entity)
    entity = entity or context.Target
    return WieldingWeapon('Reach', false, true, entity)
end

function Goon_Bow_Check(entity)
    entity = entity or context.Target
    return WieldingWeapon('Ammunition', false, true, entity)
end

function Goon_Crossbow_Check(entity)
    entity = entity or context.Target
    return WieldingWeapon('Loading', false, true, entity) -- result was discarded, always returned nil
end

function Goon_HasLightArmor(entity)
    entity = entity or context.Target
    local armor = GetActiveArmor(entity)
    return IsOfProficiencyGroup("LightArmor", armor)
end

-- Alternative light armor check matching how it's checked in vanilla
function Goon_HasLightArmorAlt(entity)
    entity = entity or context.Target
    local armor = GetActiveArmor(entity)
    local hasLightArmor = armor.ArmorType == ArmorType.Padded or armor.ArmorType == ArmorType.Leather or
    armor.ArmorType == ArmorType.StuddedLeather
    return ConditionResult(hasLightArmor)
end

-- WearingArmor and HasShieldEquipped functions DGAF about you being in wildshape and count your equipment, unlike when using GetItemInEquipmentSlot where it doesn't work for wildshape.
function Goon_NotWearingArmorOrHasShieldEquipped(entity)
    entity = entity or context.Source
    return (~WearingArmor(entity) & ~HasShieldEquipped(entity) | Goon_IsRestrictedPolymorphStatus()) 
         & Goon_IsNonHostilePolymorphStatus()
end

function Goon_NotWearingArmor(entity)
    entity = entity or context.Source
    return (~WearingArmor(entity) | Goon_IsRestrictedPolymorphStatus()) 
         & Goon_IsNonHostilePolymorphStatus()
end

function Goon_NotHasShieldEquipped(entity)
    entity = entity or context.Source
    return (~HasShieldEquipped(entity) | Goon_IsRestrictedPolymorphStatus()) 
         & Goon_IsNonHostilePolymorphStatus()
end

