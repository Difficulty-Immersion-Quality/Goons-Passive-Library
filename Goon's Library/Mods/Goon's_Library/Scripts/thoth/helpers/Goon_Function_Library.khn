-- ==================================== IsSpellChildOrVariantFromContext bug fixing
-- It also checks CombatAIOverrideSpell which is blank for most spells and may give you lots of false positives.
-- For example if there is no spell set in the context, IsSpellChildOrVariantFromContext("Target_HoldMonster") will still return true. So keep that in mind. - From joow.
-- Found in 5e Spells and surely other mods too.

function IsSpellChildOrVariantFromContext(spellId)
  -- No maidens?
  if spellId == "" then
    return ls.thoth.shared.IsSpellChildOrVariantFromContext(spellId)
  end

  -- ong that spell better be more than some quotes fr
  return ls.thoth.shared.IsSpellChildOrVariantFromContext(spellId) & ~ls.thoth.shared.IsSpellChildOrVariantFromContext("")
end

-- ==================================== HasEnemyWithinRange bug fixing
-- Credit to XiphiasRex - Enemies are now filtered properly based on exclusionStatus and tag.
-- TODO: I feel like this could be expanded some, I want to filter better. Saying no to a single status, or yes to a tag is pretty limited.
-- Need to think a bit on how best to differentiate between dudes that actually pose a threat vs ones who don't. Incapacitated exclusions gets a good ways, but it's not everything.

function HasEnemyWithinRange(exclusionStatus, distance, tag, NumberOfEnemy, target, source)
    distance = distance or 1.5
    NumberOfEnemy = NumberOfEnemy or 1
    target = target or context.Target
    source = source or context.Source

    -- local errorTrue = {ConditionError("HasAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    local errorTrue = {ConditionError("Goon_HasEnemyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    -- local errorFalse = {ConditionError("HasNotAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    local errorFalse = {ConditionError("Goon_HasNotEnemyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}

    -- get all enemies in range
    local enemies = GetEnemiesWithinRange(distance, target, source)
    -- if enemies ~= nil then
        -- Only do the check when we are surounded by more than or equal the NumberOfEnemy
        -- if #enemies.Enemies >= NumberOfEnemy then

    -- only both if total enemies is at least desired amount
        if enemies ~= nil and #enemies.Enemies >= NumberOfEnemy then
            local validEnemies = 0

            for _, entity in ipairs(enemies.Enemies) do
                -- ensure entity does not have the excluded status
                local noExcludedStatus = ConditionResult(exclusionStatus == nil)
                if exclusionStatus then
                    noExcludedStatus = ~HasStatus(exclusionStatus, entity)
                end

                -- filter by tag if provided
                local hasTag = ConditionResult(tag == nil)
                if tag then
                    hasTag = Tagged(tag, entity)
                end

            -- increment counter
                if noExcludedStatus.Result and hasTag.Result then
                validEnemies = validEnemies + 1
            end

            -- if at desired amount we done
            if validEnemies >= NumberOfEnemy then
                    return ConditionResult(true, errorFalse, errorTrue)
                -- end
            end
        end
    end
    return ConditionResult(false, errorFalse, errorTrue)
end

-- ==================================== Attack types ====================================
-- Vanilla only has functions for IsWeaponAttack(), IsMainHandAttack(), IsMainHandWeaponAttack(), IsOffHandAttack(), IsMeleeAttack(), IsRangedAttack(), IsUnarmedAttack(), and IsMeleeUnarmedAttack().
-- No such thing as unarmed offhand attacks mechanically(?), even with stuff like Flurry of Blows animations saying otherwise.
-- Some actions and spells use weapon damage but don't have an attack roll, needing to be manually listed or caught another way.

function Goon_IsMeleeMainhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.MeleeWeaponAttack)
         | IsSpellChildOrVariantFromContext('Target_MAG_WeaponAction_GrandSlam') -- Actions
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave')
         | IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Melee') -- Spells
         | Goon_IsFlameBladeSpellAttack_Mainhand()
end

function Goon_IsMeleeOffhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack)
         | IsSpellChildOrVariantFromContext('Goon_Target_MAG_WeaponAction_GrandSlam_Offhand') -- Actions
         | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Melee_Offhand') -- Spells
         | Goon_IsFlameBladeSpellAttack_Offhand()
end

function Goon_IsRangedMainhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.RangedWeaponAttack)
         | IsSpellChildOrVariantFromContext('Target_MAG_RetrievingShot') -- Actions
         | IsSpellChildOrVariantFromContext('Zone_ArcaneShot_PiercingArrow')
         | IsSpellChildOrVariantFromContext('Projectile_ArcaneShot_SeekingArrow')
         | IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Ranged') -- Spells
         | IsSpellChildOrVariantFromContext('Projectile_HailOfThorns')
         | IsSpellChildOrVariantFromContext('Projectile_PLA_HailOfThorns_ZhentCave_Gloves')
end

function Goon_IsRangedOffhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.RangedOffHandWeaponAttack)
         | IsSpellChildOrVariantFromContext('Goon_Target_MAG_RetrievingShot_Offhand') -- Actions
         | IsSpellChildOrVariantFromContext('Goon_Zone_ArcaneShot_PiercingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_ArcaneShot_SeekingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Ranged_Offhand') -- Spells
         | IsSpellChildOrVariantFromContext('Goon_Projectile_HailOfThorns_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_PLA_HailOfThorns_ZhentCave_Gloves_Offhand')
end

-- I'm conflicted with what I'm doing regarding throwing and shit, but here's a function anyway.
function Goon_IsThrownWeaponAttack()
    return SpellTypeIs(SpellType.Throw) & HasWeaponProperty(WeaponProperties.Melee, context.HitDescription.ThrownObject)
end

-- ==================================== AttackedWithPassiveSourceWeapon() edge cases
-- TODO: IsAttack SpellFlags?

function Goon_IsWeaponActionWithoutAttackRoll()
    return Goon_IsWeaponActionWithoutAttackRoll_Melee()
         | Goon_IsWeaponActionWithoutAttackRoll_Ranged()
         | Goon_IsWeaponActionWithoutAttackRoll_MeleeSpell()
         | Goon_IsWeaponActionWithoutAttackRoll_RangedSpell()
end

function Goon_IsWeaponActionWithoutAttackRoll_Melee()
    return IsSpellChildOrVariantFromContext('Target_MAG_WeaponAction_GrandSlam')                    | IsSpellChildOrVariantFromContext('Goon_Target_MAG_WeaponAction_GrandSlam_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave') | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_ZephyrBreak')                                 | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_ZephyrBreak_Offhand')
         | IsSpellChildOrVariantFromContext('Rush_MAG_ZephyrFlash')                                 | IsSpellChildOrVariantFromContext('Goon_Rush_MAG_ZephyrFlash_Offhand')
end

function Goon_IsWeaponActionWithoutAttackRoll_Ranged()
    return IsSpellChildOrVariantFromContext('Target_MAG_RetrievingShot')                            | IsSpellChildOrVariantFromContext('Goon_Target_MAG_RetrievingShot_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_ArcaneShot_PiercingArrow')                        | IsSpellChildOrVariantFromContext('Goon_Zone_ArcaneShot_PiercingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_ArcaneShot_SeekingArrow')                   | IsSpellChildOrVariantFromContext('Goon_Projectile_ArcaneShot_SeekingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_SunbeamShot')                       | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_SunbeamShot_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_SunbeamShot_Recreate')              | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_SunbeamShot_Recreate_Offhand')
end

function Goon_IsWeaponActionWithoutAttackRoll_MeleeSpell()
    return IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Melee')                            | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Melee_Offhand')
end

function Goon_IsWeaponActionWithoutAttackRoll_RangedSpell()
    return IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Ranged')                           | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Ranged_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_HailOfThorns')                              | IsSpellChildOrVariantFromContext('Goon_Projectile_HailOfThorns_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_PLA_HailOfThorns_ZhentCave_Gloves')         | IsSpellChildOrVariantFromContext('Goon_Projectile_PLA_HailOfThorns_ZhentCave_Gloves_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_LightningArrow')                            | IsSpellChildOrVariantFromContext('Goon_Projectile_LightningArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_MAG_LightningArrow_Shot')                   | IsSpellChildOrVariantFromContext('Goon_Projectile_MAG_LightningArrow_Shot_Offhand')
end

-- ==================================== Spell Target conditions ====================================
-- WIP functions for trying to condense "TargetConditions" as much as possible.
-- TODO: Many more will be made, hard to get a grasp on it before just seeing what would be proper useful to consolidate.
-- TODO: These will probably get moved to their own file, with checks for individual spells groups by level and listed alphabetically.

function Goon_TargetConditions_HarmfulProjectile()
    return Goon_IsPlayerInControl() & ~Self()
         | Goon_IsAIInControl() & ~Self() & (Enemy() | Item() | Goon_IsSurface())
end

function Goon_TargetConditions_BeneficialProjectile()
    return Goon_IsPlayerInControl() & ~Self()
         | Goon_IsAIInControl() & (Character() and Ally())
end

function Goon_TargetConditions_HarmfulTarget()
    return Goon_IsPlayerInControl() & ~Self() & (Item() or Character() or Dead())
         | Goon_IsAIInControl() & (Character() and Enemy())
end

function Goon_TargetConditions_BeneficialTarget()
    return Goon_IsPlayerInControl() & (Item() or Character() or Dead())
         | Goon_IsAIInControl() & (Character() and Ally())
end

-- ==================================== Interrupt conditions ====================================

function Goon_BasicHarmfulInterruptConditions()
    return (Player(context.Observer) | ~HasStatus('SG_Invisible', context.Observer))
        & IsAbleToReact(context.Observer)
        & (~HasStatus('SG_Invisible', context.Target) | Goon_CanSeeInvisible())
end

function Goon_AttackOfOpportunityConditions()
    return Goon_BasicHarmfulInterruptConditions()
        & Enemy()
        & (Goon_IsPlayerInControl() | ~HasAnyStatus({ 'SANCTUARY', 'SANCTUARY_TRANQUILITY' }, {}, {}, context.Source))
        & ~WieldingWeapon('Ammunition', false, false, context.Source)
        & ~HasAnyStatus({ 'SG_Incapacitated', 'SG_Unconscious', 'MOBILE_NO_AOO' }, {}, {}, context.Source)
        & ~HasAnyStatus({ 'GNOLL_SUDDENRUSH', 'SHOCKWAVE', 'MOBILE_NO_AOO_SOURCE', 'SNEAKING', 'SG_Ignore_AOO' }, {}, {}, context.Target)
        & ~(~Goon_IsPlayerInControl() & Tagged('AI_IGNORED_TARGET'))
        & ~Goon_HasFlamingSphereAuraCondition()
        & ~AnyEntityIsItem()
        & ~HasSpellFlag(SpellFlags.IgnoreAoO, context.Target)
        & ~(HasStatus('FANCYFOOTWORK', context.Source, context.Target) & HasStatus('FANCYFOOTWORK_OWNER', context.Target))
        & ((~HasStatus('PANACHE', context.Source)) | (HasStatus('PANACHE', context.Source) & HasStatus('PANACHE_OWNER', context.Target)))
end

-- // Regular:
-- // Goon_AttackOfOpportunityConditions() and not Self(context.Observer, context.Target)

-- // War Caster:
-- // Goon_AttackOfOpportunityConditions() and not Self(context.Observer, context.Target) and Self(context.Observer, context.Source) and not HasSpellCastBlocked(context.Observer)

-- // Polarm Master:
-- // Goon_AttackOfOpportunityConditions() and Self(context.Source,context.Observer) and (Tagged('WPN_GLAIVE', GetActiveWeapon(context.Source, true)) or Tagged('WPN_HALBERD', GetActiveWeapon(context.Source, true)) or Tagged('WPN_JAVELIN', GetActiveWeapon(context.Source, true)) or Tagged('WPN_PIKE', GetActiveWeapon(context.Source, true)) or Tagged('WPN_STAVE', GetActiveWeapon(context.Source, true)) or Tagged('WPN_SPEAR', GetActiveWeapon(context.Source, true)) or Tagged('WPN_TRIDENT', GetActiveWeapon(context.Source, true)))

-- ==================================== Player vs NPC checks + in control vs not in control ====================================
-- TODO: Check for edge cases where an AI controlled character might be a "Player", or find a better means of checking this stuff.

function Goon_IsPlayerInControl()
    return Player(context.Source) & ~Goon_IsEntityDominated() & ~Goon_IsEntityMad()
end

function Goon_IsAIInControl()
    return (Player(context.Source) & Goon_IsEntityDominated() | ~Player(context.Source)) & ~Goon_IsEntityMad()
end

function Goon_IsEntityMad()
    return HasAnyStatus({ 'SG_Mad' }, {}, {})
end

function Goon_IsEntityDominated()
    return HasAnyStatus({ 'SG_Dominated', 'SG_Possessed' }, {}, {})
end

-- ==================================== STATUS GROUPINGS ETC. ====================================

-- ==================================== Metal

function Goon_IsMetal()
    return IsMetalItem() or HasMetalWeaponInAnyHand() or HasMetalArmor() or IsMetalCharacter()
end

-- ==================================== Bleeding

function Goon_HasBleedingCondition()
    return HasAnyStatus({ 'BLEEDING', 'BARBED_ARROW', 'HEAVY_BLEEDING' }, {}, {})
end

-- ==================================== Silenced/Deafened

function Goon_HasSilencedCondition()
    -- GOON_SILENCED_AURA: not in the lua, intentional?
    return HasAnyStatus({ 'SILENCED', 'SHA_SILENTLIBRARY_LIBRARIANSILENCE_STATUS', 'LOW_VoicelessPenitent_Silenced', 'SILENCED_MOVEMENT', 'GARROTE_SILENCED' }, {}, {})
end

function Goon_HasDeafenedCondition()
    return HasAnyStatus({ 'DEAFENED', 'DEAF', 'DEAFNESS', 'GOON_DEAFENED', 'GOON_REAL_INJURY_GRIT_GLORY_DEAFNESS', 'GOON_REAL_INJURY_GRIT_GLORY_PARTIAL_DEAFNESS' }, {}, {}) -- | HasPassive('Deafness')
end

-- TODO: "not" instead of ~? Allowed in if statement?
-- IsDeaf not an included function
function SavingThrow_SoundBased(ability, dc, advantage, disadvantage, target)
    local advantage = advantage or false
    local disadvantage = disadvantage or false
    local target = target or context.Target

    if not IsDeaf(target).Result then
        st = SavingThrow(ability, dc, advantage, disadvantage, target)
        return ConditionResult(st.Result, {}, {}, st.Chance)
    else
        return true -- plain bool; if callers use | / & / .Result on this it would break; consider ConditionResult(true)
    end
end

-- ==================================== Prone
-- "Target_ExtractBrain_Mindflayer" has some dumb shit going on, and why is there such overlap between prone and unconscious anyway?
-- TODO: Unfuck prone I guess.

function Goon_HasProneCondition_Conscious()
    return HasAnyStatus({ 'PRONE','PRONE_GREASE','PRONE_ICE','PRONE_FALLEN','PRONE_THUNDEROUS_SMITE' }, {}, {})
end

function Goon_HasProneCondition_Unconscious()
    return HasStatus('SG_Prone') & HasStatus('SG_Unconscious') & ~Goon_HasProneCondition_Conscious()
end

-- ==================================== Surfaces
-- TODO: Break into groups and call them all in the main function.

function Goon_IsSurface()
    result = Surface('SurfaceNone')
           | Surface('SurfaceWater')
           | Surface('SurfaceWaterElectrified')
           | Surface('SurfaceWaterFrozen')
           | Surface('SurfaceBlood')
           | Surface('SurfaceBloodElectrified')
           | Surface('SurfaceBloodFrozen')
           | Surface('SurfacePoison')
           | Surface('SurfaceOil')
           | Surface('SurfaceLava')
           | Surface('SurfaceGrease')
           | Surface('SurfaceWyvernPoison')
           | Surface('SurfaceWeb')
           | Surface('SurfaceDeepwater')
           | Surface('SurfaceVines')
           | Surface('SurfaceFire')
           | Surface('SurfaceAcid')
           | Surface('SurfaceTrialFire')
           | Surface('SurfaceBlackpowder')
           | Surface('SurfaceAlienoil')
           | Surface('SurfaceMud')
           | Surface('SurfaceAlcohol')
           | Surface('SurfaceInvisibleWeb')
           | Surface('SurfaceBloodSilver')
           | Surface('SurfaceChasm')
           | Surface('SurfaceHellfire')
           | Surface('SurfaceCausticBrine')
           | Surface('SurfaceBloodExploding')
           | Surface('SurfaceAsh')
           | Surface('SurfaceSpikeGrowth')
           | Surface('SurfaceHolyFire')
           | Surface('SurfaceBlackTentacles')
           | Surface('SurfaceOvergrowth')
           | Surface('SurfacePurpleWormPoison')
           | Surface('SurfaceSerpentVenom')
           | Surface('SurfaceInvisibleGithAcid')
           | Surface('SurfaceBladeBarrier')
           | Surface('SurfaceSewer')
           | Surface('SurfaceWaterCloud')
           | Surface('SurfaceWaterCloudElectrified')
           | Surface('SurfacePoisonCloud')
           | Surface('SurfaceExplosionCloud')
           | Surface('SurfaceShockwaveCloud')
           | Surface('SurfaceCloudkillCloud')
           | Surface('SurfaceMaliceCloud')
           | Surface('SurfaceBloodCloud')
           | Surface('SurfaceStinkingCloud')
           | Surface('SurfaceDarknessCloud')
           | Surface('SurfaceFogCloud')
           | Surface('SurfaceGithPheromoneGasCloud')
           | Surface('SurfaceSporeWhiteCloud')
           | Surface('SurfaceSporeGreenCloud')
           | Surface('SurfaceSporeBlackCloud')
           | Surface('SurfaceDrowPoisonCloud')
           | Surface('SurfaceIceCloud')
           | Surface('SurfacePotionHealingCloud')
           | Surface('SurfacePotionHealingGreaterCloud')
           | Surface('SurfacePotionHealingSuperiorCloud')
           | Surface('SurfacePotionHealingSupremeCloud')
           | Surface('SurfacePotionInvisibilityCloud')
           | Surface('SurfacePotionSpeedCloud')
           | Surface('SurfacePotionVitalityCloud')
           | Surface('SurfacePotionAntitoxinCloud')
           | Surface('SurfacePotionResistanceAcidCloud')
           | Surface('SurfacePotionResistanceColdCloud')
           | Surface('SurfacePotionResistanceFireCloud')
           | Surface('SurfacePotionResistanceForceCloud')
           | Surface('SurfacePotionResistanceLightningCloud')
           | Surface('SurfacePotionResistancePoisonCloud')
           | Surface('SurfaceSporePinkCloud')
           | Surface('SurfaceBlackPowderDetonationCloud')
           | Surface('SurfaceVoidCloud')
           | Surface('SurfaceCrawlerMucusCloud')
           | Surface('SurfaceCloudkill6Cloud')
           | Surface('SurfaceSentinel')
    return ConditionResult(result.Result, { ConditionError("Goon_IsNotSurface") })
end

function Goon_IsDippableSurface()
    result = Surface('SurfaceFire')
           | Surface('SurfaceHellfire')
           | Surface('SurfacePoison')
           | Surface('SurfaceWater')
           | Surface('SurfaceSerpentVenom')
           | Surface('SurfaceWyvernPoison')
           | Surface('SurfacePurpleWormPoison')
    return ConditionResult(result.Result, { ConditionError("Goon_IsNotDippableSurfaceOrEntity") })
end

-- ==================================== Fire shit - Is Karlach cooking?

function Goon_HasBurningCondition()
    return ConditionResult((Goon_HasBurningCondition_Normal() | Goon_HasBurningCondition_Holy() | Goon_HasBurningCondition_Hell()).Result, { ConditionError("IsNotOnFire") }) -- inlined result variable; .Result: | returns ConditionResult, error overload needs a plain bool
end

function Goon_HasBurningConditionOrTag_Normal()
    return ConditionResult((Goon_HasBurningCondition_Normal() | Goon_IsKarlachCooking()).Result, { ConditionError("IsNotOnFire") }) -- inlined result variable; see above re .Result
end

function Goon_HasBurningConditionOrTag()
    return ConditionResult((Goon_HasBurningCondition_Normal() | Goon_IsKarlachCooking() | Goon_HasBurningCondition_Holy() | Goon_HasBurningCondition_Hell()).Result, { ConditionError("IsNotOnFire") }) -- inlined result variable; see above re .Result
end

-- ==================================== List functions

function Goon_HasBurningCondition_Normal()
    return HasAnyStatus({ 'BURNING', 'BURNING_AZER', 'BURNING_LAVA', 'BURNING_TRAPWALL', 'FLAMING_SPHERE_AURA', 'FLAMING_SPHERE_AURA_3', 'FLAMING_SPHERE_AURA_4', 'FLAMING_SPHERE_AURA_5', 'FLAMING_SPHERE_AURA_6', 'FLAMING_SPHERE_AURA_7', 'FLAMING_SPHERE_AURA_8', 'FLAMING_SPHERE_AURA_9', 'FLAMING_SPHERE', 'FLAMING_SPHERE_3', 'FLAMING_SPHERE_4', 'FLAMING_SPHERE_5', 'FLAMING_SPHERE_6', 'FLAMING_SPHERE_7', 'FLAMING_SPHERE_8', 'FLAMING_SPHERE_9', 'HAV_MAG_INFERNAL_FIRE', 'LOW_HOH_BOAR_BURNING_DAMAGE', 'MAG_FIRE_HEAT', 'MAG_INFERNAL_BURNING', 'ORI_KARLACH_ENRAGE', 'ORI_KARLACH_INFERNAL_FURY', 'SEARING_SMITE', 'WILD_MAGIC_BURNING' }, {}, {})
end

function Goon_HasBurningCondition_Holy()
    return HasAnyStatus({ 'BURNING_HOLY' }, {}, {})
end

function Goon_HasBurningCondition_Hell()
    return HasAnyStatus({ 'BURNING_HELLFIRE' }, {}, {})
end

function Goon_IsKarlachCooking()
    return Tagged('REALLY_KARLACH') & ~Tagged('KARLACH_CAN_TOUCH')
end

function Goon_HasFlamingSphereAuraCondition()
    return HasAnyStatus({ 'FLAMING_SPHERE_AURA', 'FLAMING_SPHERE_AURA_3', 'FLAMING_SPHERE_AURA_4', 'FLAMING_SPHERE_AURA_5', 'FLAMING_SPHERE_AURA_6', 'FLAMING_SPHERE_AURA_7', 'FLAMING_SPHERE_AURA_8', 'FLAMING_SPHERE_AURA_9' }, {}, {})
end

-- ==================================== Fetch character levels ====================================

function Goon_CharacterLevelEqualTo(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level == value)
end

function Goon_CharacterLevelEqualToOrGreaterThan(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level >= value)
end

function Goon_CharacterLevelEqualToOrGreaterThan_5(entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level >= 5)
end

function Goon_CharacterLevelGreaterThan(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level > value)
end

function Goon_CharacterLevelLessThan(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level < value)
end

function Goon_CharacterLevelGreaterThanOrEqual(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level >= value)
end

function Goon_CharacterLevelLessThanOrEqual(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level <= value)
end

function Goon_IsCharacterLevelEqualOrBetween(value, value2, entity)
    local entity = entity or context.Source
    return Goon_CharacterLevelGreaterThanOrEqual(value, entity) & Goon_CharacterLevelLessThanOrEqual(value2, entity)
end

-- ==================================== Ability modifier not a negative value ====================================
-- Functions to ensure ability modifiers aren't negative values when doing scaling bonuses

function Goon_IsStrengthModifierPositive()
    return GetModifier(context.Source.Strength) > 0
end

function Goon_IsDexterityModifierPositive()
    return GetModifier(context.Source.Dexterity) > 0
end

function Goon_IsConstitutionModifierPositive()
    return GetModifier(context.Source.Constitution) > 0
end

function Goon_IsIntelligenceModifierPositive()
    return GetModifier(context.Source.Intelligence) > 0
end

function Goon_IsWisdomModifierPositive()
    return GetModifier(context.Source.Wisdom) > 0
end

function Goon_IsCharismaModifierPositive()
    return GetModifier(context.Source.Charisma) > 0
end

-- ==================================== Check current duration of status ====================================

function Goon_StatusGroupDurationEqualTo(entity, stringStatusGroupName, number)
    local entity = entity or context.Target
    local number = number or 0
    return ConditionResult(math.floor(GetStatusDuration(stringStatusGroupName, entity)) == number)
end

-- ==================================== Spell batching ====================================
-- TODO: Referencing the interrupts below doesn't really work the same as spells, e.g. OnDamage contexts for functors.
-- Best course of action is likely to have the interrupts UseSpell, replacing animations with the instant cast one. "Target_NULLSPELL"?
