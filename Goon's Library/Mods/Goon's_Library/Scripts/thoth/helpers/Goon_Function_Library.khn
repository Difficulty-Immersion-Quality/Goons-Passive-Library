function Goon_IsSpellcastingModifierWeapon()
    return HasAnyStatus({ 'SHILLELAGH', 'MAG_MELEE_CASTER_BOON', 'LHB_SEL_TASHASOTHERWORLDLYGUISE_MAGICWEAPON', 'MAG_MELEE_CASTER_BOON_SORROW', 'MAG_MELEE_CASTER_BOON_LATHANDER', 'GOON_SHADOW_BLADE_2', 'GOON_SHADOW_BLADE_3', 'GOON_SHADOW_BLADE_4', 'GOON_SHADOW_BLADE_5', 'GOON_SHADOW_BLADE_6', 'GOON_SHADOW_BLADE_7', 'GOON_SHADOW_BLADE_8', 'GOON_SHADOW_BLADE_9', 'GOON_FLAME_BLADE_MEPHISTOPHELES', 'GOON_FLAME_BLADE_2', 'GOON_FLAME_BLADE_3', 'GOON_FLAME_BLADE_4', 'GOON_FLAME_BLADE_5', 'GOON_FLAME_BLADE_6', 'GOON_FLAME_BLADE_7', 'GOON_FLAME_BLADE_8', 'GOON_FLAME_BLADE_9' }, {}, {})
end

function Goon_IsIntelligenceModifierWeapon()
    return HasAnyStatus({}, {}, {})
end

function Goon_IsWisdomModifierWeapon()
    return HasAnyStatus({ 'FourEle_Attuned' }, {}, {})
end

function Goon_IsCharismaModifierWeapon()
    return HasAnyStatus({ 'HEXBLADE_BIND', 'PACT_BLADE' }, {}, {}) | Tagged('PACT_OF_THE_BLADE')
end

function Goon_IsShadowBladeWeapon()
    return HasAnyStatus({ 'SHADOWBLADE_TECHNICAL', 'GOON_KNIFEOFTHEUNDERMOUNTAINKING_WEAPON_TECHNICAL', 'GOON_SHADOWRENDINGDAGGER_WEAPON_TECHNICAL', 'GOON_JUSTICIARSSCIMITAR_WEAPON_TECHNICAL' }, {}, {})
end

-- ==================================== Weapon enchant checks - Cahoot's revision
-- Works unlike the above blocks

function Goon_AttackingWithSpellcastingModifierWeapon()
    return HasStatus('SHILLELAGH', GetAttackWeapon(context.Source))
         | HasStatus('MAG_MELEE_CASTER_BOON', GetAttackWeapon(context.Source))
         | HasStatus('LHB_SEL_TASHASOTHERWORLDLYGUISE_MAGICWEAPON', GetAttackWeapon(context.Source))
         | HasStatus('MAG_MELEE_CASTER_BOON_SORROW', GetAttackWeapon(context.Source))
         | HasStatus('MAG_MELEE_CASTER_BOON_LATHANDER', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_2', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_3', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_4', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_5', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_6', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_7', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_8', GetAttackWeapon(context.Source))
         | HasStatus('GOON_SHADOW_BLADE_9', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_MEPHISTOPHELES', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_2', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_3', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_4', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_5', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_6', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_7', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_8', GetAttackWeapon(context.Source))
         | HasStatus('GOON_FLAME_BLADE_9', GetAttackWeapon(context.Source))
end

-- function Goon_AttackingWithIntelligenceModifierWeapon()
--     return HasAnyStatus({}, {}, {})
-- end

function Goon_AttackingWithWisdomModifierWeapon()
    return HasStatus('FourEle_Attuned', GetAttackWeapon(context.Source))
end

function Goon_AttackingWithCharismaModifierWeapon()
    return HasStatus('HEXBLADE_BIND', GetAttackWeapon(context.Source)) | HasStatus('PACT_BLADE', GetAttackWeapon(context.Source))
end

-- ==================================== Weapon enchant checks - Trying something different
-- TODO: Need to be able to just get them in the most generic way possible, not checking for attack weapon.
-- GetActiveWeapon
-- GetItemInEquipmentSlot
-- MartialArts_DextrousUnarmedAttacks in DIQ Misc Patches needs this shit bad.
-- Might need additional custom statuses for my Shadow Blade/Flame Blade edits.

function Goon_IsPactWeapon()
    return StatusId('PACT_BLADE') | StatusId('HEXBLADE_BIND') | Tagged('PACT_OF_THE_BLADE')
end

function Goon_HasPactWeapon()
    return HasStatus('PACT_BLADE') | HasStatus('HEXBLADE_BIND') | Tagged('PACT_OF_THE_BLADE')
end

-- ==================================== Weapon enchant checks - Bound weapons only
-- TODO: Add support for any custom statuses that fit the bill
-- TODO: Replace all instances where all 3 of these are called with the functions

function Goon_IsBoundWeaponStatus()
    return (StatusId('WEAPON_BOND') | StatusId('PACT_BLADE') | StatusId('HEXBLADE_BIND'))
end

function Goon_HasBoundWeaponStatus()
    return (HasStatus('WEAPON_BOND') | HasStatus('PACT_BLADE') | HasStatus('HEXBLADE_BIND'))
end

function Goon_AttackingWithBoundWeapon()
    return HasStatus('WEAPON_BOND', GetAttackWeapon(context.Source))
         | HasStatus('PACT_BLADE', GetAttackWeapon(context.Source))
         | HasStatus('HEXBLADE_BIND', GetAttackWeapon(context.Source))
end

-- ==================================== Weapon enchant checks - Vanilla Flame Blade
-- Don't need to add my custom conditions here, it's already doing an attack roll in Goon's Spell Overhaul.

function Goon_IsFlameBladeSpellAttack()
    return Goon_IsFlameBladeSpellAttack_Mainhand() | Goon_IsFlameBladeSpellAttack_Offhand()
end

function Goon_IsFlameBladeSpellAttack_Mainhand()
    return IsMeleeSpellAttack()
         & HasStatus('FLAME_BLADE', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_3', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_4', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_5', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_6', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_7', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_8', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_9', GetActiveWeapon(context.Source, true))
         | HasStatus('FLAME_BLADE_MEPHISTOPHELES', GetActiveWeapon(context.Source, true))
end

function Goon_IsFlameBladeSpellAttack_Offhand()
    return IsMeleeSpellAttack()
         & HasStatus('FLAME_BLADE', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_3', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_4', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_5', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_6', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_7', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_8', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_9', GetActiveWeapon(context.Source, false))
         | HasStatus('FLAME_BLADE_MEPHISTOPHELES', GetActiveWeapon(context.Source, false))
end

-- ==================================== Tag piles ====================================
-- Mod support: FIREARM_MOD = Artificer
-- NOTE: These will not work for boosts using context.HitDescription.ThrownObject. But maybe declaring that context in the functions themselves will work.
-- HasAnyTags only works in stats and not khn, but unlike Tagged it works with context.HitDescription.ThrownObject, despite only having one use case in the whole fucking game.

function Goon_IsWeapon()
    return Goon_IsMeleeWeapon()
         | Goon_IsRangedWeapon()
end

-- Just use HasWeaponProperty(WeaponProperties.Melee, context.HitDescription.ThrownObject) instead
function Goon_IsMeleeWeapon()
    return Tagged('WPN_BATTLEAXE')
         | Tagged('WPN_CLUB')
         | Tagged('WPN_DAGGER')
         | Tagged('WPN_DART')
         | Tagged('WPN_FLAIL')
         | Tagged('WPN_GLAIVE')
         | Tagged('WPN_GREATAXE')
         | Tagged('WPN_GREATSWORD')
         | Tagged('WPN_HALBERD')
         | Tagged('WPN_HANDAXE')
         | Tagged('WPN_JAVELIN')
         | Tagged('WPN_LIGHT_HAMMER')
         | Tagged('WPN_LONGSWORD')
         | Tagged('WPN_MACE')
         | Tagged('WPN_MAUL')
         | Tagged('WPN_MORNINGSTAR')
         | Tagged('WPN_PIKE')
         | Tagged('WPN_STAVE')
         | Tagged('WPN_RAPIER')
         | Tagged('WPN_SCIMITAR')
         | Tagged('WPN_SHORTSWORD')
         | Tagged('WPN_SICKLE')
         | Tagged('WPN_SPEAR')
         | Tagged('WPN_TRIDENT')
         | Tagged('WPN_WAR_PICK')
         | Tagged('WPN_WARHAMMER')
end

-- Just use HasWeaponProperty(WeaponProperties.Ammunition, context.HitDescription.ThrownObject) instead
function Goon_IsRangedWeapon()
    return Tagged('WPN_HAND_CROSSBOW')
         | Tagged('WPN_HEAVY_CROSSBOW')
         | Tagged('WPN_LIGHT_CROSSBOW')
         | Tagged('WPN_LONGBOW')
         | Tagged('WPN_SHORTBOW')
         | Tagged('WPN_SLING')
         | Tagged('FIREARM_MOD')
end

function Goon_IsThrownWeapon()
    return HasWeaponProperty(WeaponProperties.Thrown)
end

function Goon_IsAxe()
    return Tagged('WPN_BATTLEAXE')
         | Tagged('WPN_GREATAXE')
         | Tagged('WPN_HANDAXE')
end

function Goon_IsPolearm()
    return Tagged('WPN_GLAIVE')
         | Tagged('WPN_HALBERD')
         | Tagged('WPN_JAVELIN')
         | Tagged('WPN_PIKE')
         | Tagged('WPN_STAVE')
         | Tagged('WPN_SPEAR')
         | Tagged('WPN_TRIDENT')
end

function Goon_IsSword()
    return Tagged('WPN_GREATSWORD')
         | Tagged('WPN_LONGSWORD')
         | Tagged('WPN_RAPIER')
         | Tagged('WPN_SCIMITAR')
         | Tagged('WPN_SHORTSWORD')
end

function Goon_IsHammer()
    return Tagged('WPN_LIGHT_HAMMER')
         | Tagged('WPN_MAUL')
         | Tagged('WPN_WARHAMMER')
end

-- ==================================== Magical unarmed ====================================
-- Hunting down everything with the UnarmedMagicalProperty() boost.
-- Supports Expansion, 5e Spells, Blood Hunter, Veenab stuff, Mystic Expansion, Zephyr, Mizora's Rewards, Book of Druids, Dread Overlord

function Goon_HasMagicalUnarmed(entity)
    entity = entity or context.Source
    return Goon_IsWildshapeDruidPolymorph() & HasPassive('PrimalStrike', entity)
         | HasPassive('KiEmpoweredStrikes', entity)
         | Goon_HasMagicalUnarmed_Expansion()
         | Goon_HasMagicalUnarmed_BloodHunter()
         | Goon_HasMagicalUnarmed_Veenab()
         | HasPassive('InvestmentOfTheChainMaster_Familiar', entity)
         | HasPassive('SVZephyr_TapestryTatteringArms', entity)
         | HasPassive('Passive_Mystic_FlawlessTechnique', entity)
         | HasPassive('MightySummonMagicalUnarmed', entity)
         | HasAnyStatus({ 'DREADOVERLORD_NECROTICBLADE_UNARMED' }, {}, {}, entity)
end

function Goon_HasMagicalUnarmed_Expansion(entity)
    entity = entity or context.Source
    return HasPassive('ExceptionalTraining_EXP', entity)
         | HasAnyStatus({ 'ALTER_SELF_BLUDGEONING_WEAPON', 'ALTER_SELF_SLASHING_WEAPON', 'ALTER_SELF_PIERCING_WEAPON' }, {}, {}, entity)
end

function Goon_HasMagicalUnarmed_BloodHunter(entity)
    entity = entity or context.Source
    return HasPassive('ImprovedPredatoryStrikes', entity)
         | HasPassive('ImprovedPredatoryStrikes11', entity)
end

function Goon_HasMagicalUnarmed_Veenab(entity)
    entity = entity or context.Source
    return HasPassive('VBT_ARM_UnarmedProwessWraps_MagicalStrikes_1', entity)
         | HasPassive('VBT_ARM_UnarmedProwessWraps_MagicalStrikes_2', entity)
         | HasPassive('VBT_ARM_UnarmedProwessWraps_MagicalStrikes_3', entity)
end

-- ==================================== Condition errors ====================================

function Goon_HasUnbrokenOath()
    return ConditionResult((~Tagged('OATHBREAKER', context.Source)).Result, { ConditionError("Goon_HasBrokenOath") }) -- inlined result variable; .Result: ~ returns ConditionResult, error overload needs a plain bool
end

-- TODO: Could be set up generic like, have SE apply a status and use it universally.
function Goon_HasAttackedOrCast_FirstVampireWarlock()
    return ConditionResult(HasAnyStatus({ 'GOON_DRAIN_LIFE_TECHNICAL', 'GOON_DRAIN_LIFE_TECHNICAL_ETERNAL_NIGHT' }, {}, {}, context.Source).Result, { ConditionError("Goon_HasAttackedOrCast") }) -- inlined result variable; see Goon_HasUnbrokenOath re .Result
end

-- ==================================== Druid and Polymorph stuff ====================================
-- TODO: Hunt down everything relevant.
-- Check for any and all druid forms, only druid forms and not stinky disguise self etc.
-- Mod support: Circle of Storm Chasers and the custom Circle of Stars.
-- TODO: Maybe remove declaring entities and leave it blank like condition status checks above.
-- TODO: Refactor, do functions for StatusId as well as HasStatus. Do status checks for Slayer and Myrmidons, instead of just tag.
-- TODO: Support for that one druid class mod?

function Goon_IsDruidWildshapeOrStatus(entity)
    entity = entity or context.Source
    return Goon_IsWildshapeDruidPolymorph() | Goon_IsMyrmidonDruidPolymorph() | Goon_IsHumanoidDruidPolymorph()
end

function Goon_IsDruidWildshape(entity)
    entity = entity or context.Source
    return Goon_IsWildshapeDruidPolymorph() | Goon_IsMyrmidonDruidPolymorph()
end

function Goon_IsRestrictedPolymorphStatus(entity)
    entity = entity or context.Source
    return Goon_IsWildshapeDruidPolymorph() | Goon_IsMyrmidonDruidPolymorph() | Tagged('SLAYER', entity)
end

function Goon_IsUnrestrictedPolymorphStatus(entity)
    entity = entity or context.Source
    return (Goon_IsHumanoidDruidPolymorph() | Goon_IsOtherPolymorph()) & (~Goon_IsRestrictedPolymorphStatus() & Goon_IsNonHostilePolymorphStatus())
end

-- TODO: How would I go about filtering sources of unwilling polymorphs for a custom ImmutableForm? Pseudo status group?
function Goon_IsNonHostilePolymorphStatus(entity)
    entity = entity or context.Source
    return ~Tagged('POLYMORPHED_UNWILLING', entity)
end

-- ==================================== Polymorph clusters

function Goon_IsWildshapeDruidPolymorph(entity)
    entity = entity or context.Source
    return HasAnyStatus({ 'SG_Polymorph_BeastShape' }, {}, {}, entity)
end

function Goon_IsMyrmidonDruidPolymorph(entity)
    entity = entity or context.Source
    return Tagged('MYRMIDON_AIR', entity) | Tagged('MYRMIDON_EARTH', entity) | Tagged('MYRMIDON_FIRE', entity) | Tagged('MYRMIDON_WATER', entity)
end

-- TODO: 'SYMBIOTIC_ENTITY' doesn't really fit the bill, but I feel like it would be fitting for BG3.
function Goon_IsHumanoidDruidPolymorph(entity)
    entity = entity or context.Source
    return HasAnyStatus({ 'WILDSHAPE_STARRY_ARCHER_PLAYER', 'WILDSHAPE_STARRY_CHALICE_PLAYER', 'WILDSHAPE_STARRY_DRAGON_PLAYER', 'STARRY_FORM_ARCHER', 'STARRY_FORM_CHALICE', 'STARRY_FORM_DRAGON', 'STORM_SHIFTER' }, {}, {}, entity)
end

function Goon_IsOtherPolymorph(entity)
    entity = entity or context.Source
    return HasAnyStatus({ 'SG_Disguise', 'SG_Doppelganger' }, {}, {}, entity) | Tagged('MINDFLAYER', entity)
end

-- ==================================== Surface check stuff ====================================

function Goon_CreateSurfaceSpellCheck(entity)
    entity = entity or context.Source
    return ~HasStatus('GOON_SURFACE_CHECK', entity) | HasStatus('GOON_ITEMORDEAD_CHECK', entity)
end

function Goon_IsItemOrDead(entity)
    entity = entity or context.Target
    return Item(entity) | Dead(entity)
end

-- ==================================== Blindness, Darkness, Illusions ====================================
-- TODO: These could be more robust no?

function Goon_CanIgnoreBlindness_Melee(entity)
    entity = entity or context.Source
    return IsImmuneToStatus('SG_Blinded', entity)
         | HasPassive('FightingStyle_BlindFighting', entity) & ~DistanceToGreaterThan(context.SourcePosition, context.TargetPosition, 3)
         | HasPassive('Blindsense', entity) & ~HasStatus('SG_Deafened', entity)
end

function Goon_CanIgnoreBlindness_Ranged(entity)
    entity = entity or context.Source
    return IsImmuneToStatus('SG_Blinded', entity)
         | HasPassive('Blindsense', entity) & ~HasStatus('SG_Deafened', entity)
end

function Goon_CanIgnoreIllusions(entity)
    entity = entity or context.Source
    return Tagged('BLINDSIGHT', entity) 
         | (HasStatus('TRUESIGHT', entity) | DistanceToTargetGreaterThan(36.5))
         | ((HasPassive('FightingStyle_BlindFighting', entity) | (HasPassive('Blindsense', entity)) & ~(HasPassive('Deafness', entity) or HasStatus('SG_Deafened', entity))) & ~DistanceToTargetGreaterThan(3))
         | HasPassive('WitchSight', entity) -- TODO: Same/similar distance check as TRUESIGHT?
end

-- ==================================== Invisibility & Sneaking ====================================
-- Credit to DrKekyll, Celes and Sumradagnoth for all messing with this craziness before I did.

function Goon_CanSeeInvisible(source, target, sourceObserver, targetObserver)
    local source = source or context.Source
    local target = target or context.Target
    local sourceObserver = sourceObserver or false
    local targetObserver = targetObserver or false

    local sourcePosition = context.SourcePosition
    local targetPosition = context.TargetPosition

    if sourceObserver then
        sourcePosition = context.ObserverPosition
    end

    if targetObserver then
        targetPosition = context.ObserverPosition
    end

    return Tagged('BLINDSIGHT', source)
         | (HasStatus('MIND_SPIKE_OWNER', source) & HasStatus('MIND_SPIKE', target, source))
         | (HasStatus('TRUESIGHT', source) & ~DistanceToGreaterThan(sourcePosition, targetPosition, 36.5))
         | ((HasStatus('SEE_INVISIBILITY', source) | HasStatus('MAG_SEE_INVISIBILITY_HIDDEN_IGNORE_RESTING', source) | HasPassive('AllSeeingEye', source) | HasStatus('TRUESIGHT_BOON_OF_THE_NIGHT_SPIRIT', source)) & ~DistanceToGreaterThan(sourcePosition, targetPosition, 18.5))
         | ((HasPassive('FightingStyle_BlindFighting', source) | (HasPassive('Blindsense', source) & ~(HasPassive('Deafness', source) | HasStatus('SG_Deafened', source)))) & ~DistanceToGreaterThan(sourcePosition, targetPosition, 3))
end

function Goon_CanSeeSneaking(source, target) -- from, to were declared but never used
    local source = source or context.Source
    local target = target or context.Target

    return HasStatus('MIND_SPIKE_OWNER', source) & HasStatus('MIND_SPIKE', target, source)
end

function Goon_IsInvisibleSeen(entity)
    local entity = entity or context.Target
    return HasStatus('GOON_INVISIBLE_SEEN', entity)
         | HasStatus('GOON_INVISIBLE_MAGEHAND_SEEN', entity)
         | HasStatus('GOON_INVISIBILITY_SEEN', entity)
         | HasStatus('GOON_ONE_WITH_SHADOWS_SEEN', entity)
         | HasStatus('GOON_POTION_OF_INVISIBILITY_SEEN', entity)
         | HasStatus('GOON_CLOAK_OF_SHADOWS_SEEN', entity)
         | HasStatus('GOON_CLOAK_OF_SHADOWS_MONK_SEEN', entity)
         | HasStatus('GOON_UMBRAL_CLOAK_SEEN', entity)
         | HasStatus('GOON_GREATER_INVISIBILITY_SEEN', entity)
         | HasStatus('GOON_SHADOWBLEND_SEEN', entity)
         | HasStatus('GOON_INVISIBILITY_SHADARKAI_GLOOMWEAVER_SEEN', entity)
         | HasStatus('GOON_HIDE_IN_PLAIN_SIGHT_SEEN', entity)
         | HasStatus('GOON_MISTY_ESCAPE_INVISIBLE_SEEN', entity)
         | HasStatus('GOON_INVISIBILITY_PANTHER_SEEN', entity)
         | HasStatus('GOON_SHROUD_SELF_SEEN', entity)
         | HasStatus('GOON_SUPREME_SNEAK_SEEN', entity)
         | HasStatus('GOON_MAG_INVISIBLE_WEAPON_SEEN', entity)
         | HasStatus('GOON_LOW_POLTERGEIST_INVISIBLE_SEEN', entity)
         | HasStatus('GOON_SHADOW_WALKER_SEEN', entity)
         | HasStatus('GOON_EMPTY_BODY_SEEN', entity)
end

-- ==================================== Max Strength Conditions ====================================
-- Hit Point checks
function Goon_HasMaxHP(entity)
    entity = entity or context.Target
    return ConditionResult(entity.HPPercentage == 100)
end

function Goon_IsBloodied(entity)
    entity = entity or context.Target
    return ConditionResult(HasHPPercentageEqualOrLessThan(50, entity).Result, { ConditionError("CE_Status_GOON_BLOODIED_False") }, {}) -- inlined result variable; see Goon_HasUnbrokenOath re .Result
end

-- Spellcaster resource checks
function Goon_HasPactMagic()
    return HasActionResource('WarlockSpellSlot', 1, 1, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 2, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 3, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 4, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 5, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 6, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 7, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 8, false, false, context.Source)
         | HasActionResource('WarlockSpellSlot', 1, 9, false, false, context.Source)
end

function Goon_HasSpellSlots()
    return HasActionResource('SpellSlot', 1, 1, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 2, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 3, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 4, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 5, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 6, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 7, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 8, false, false, context.Source)
         | HasActionResource('SpellSlot', 1, 9, false, false, context.Source)
end

