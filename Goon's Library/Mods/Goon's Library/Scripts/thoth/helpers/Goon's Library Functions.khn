-- ==================================== Max Strength Conditions ====================================
-- Hit Point checks
function Goon_HasMaxHP(target)
    target = target or context.Target
    return ConditionResult(target.HPPercentage == 100)
end

function Goon_IsBloodied(target)
    target = target or context.Target
    return ConditionResult(HasHPPercentageEqualOrLessThan(50, target).Result, { ConditionError("CE_Status_GOON_BLOODIED_False") }, {}) -- inlined result variable; see Goon_HasUnbrokenOath re .Result
end

-- Spellcaster resource checks
function Goon_HasPactMagic(source)
    source = source or context.Source
    return HasActionResource('WarlockSpellSlot', 1, 1, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 2, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 3, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 4, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 5, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 6, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 7, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 8, false, false, source)
         | HasActionResource('WarlockSpellSlot', 1, 9, false, false, source)
end

function Goon_HasSpellSlots(source)
    source = source or context.Source
    return HasActionResource('SpellSlot', 1, 1, false, false, source)
         | HasActionResource('SpellSlot', 1, 2, false, false, source)
         | HasActionResource('SpellSlot', 1, 3, false, false, source)
         | HasActionResource('SpellSlot', 1, 4, false, false, source)
         | HasActionResource('SpellSlot', 1, 5, false, false, source)
         | HasActionResource('SpellSlot', 1, 6, false, false, source)
         | HasActionResource('SpellSlot', 1, 7, false, false, source)
         | HasActionResource('SpellSlot', 1, 8, false, false, source)
         | HasActionResource('SpellSlot', 1, 9, false, false, source)
end

