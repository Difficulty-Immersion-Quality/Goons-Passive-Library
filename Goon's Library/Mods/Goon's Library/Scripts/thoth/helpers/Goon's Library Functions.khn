function Goon_IsDippableSurface()
    local result = Surface('SurfaceFire')
                 | Surface('SurfaceHellfire')
                 | Surface('SurfacePoison')
                 | Surface('SurfaceWater')
                 | Surface('SurfaceSerpentVenom')
                 | Surface('SurfaceWyvernPoison')
                 | Surface('SurfacePurpleWormPoison')
    return ConditionResult(result.Result, { ConditionError("Goon_IsNotDippableSurfaceOrEntity") })
end

-- ==================================== Fire shit - Is Karlach cooking?
-- inlined result variable; .Result: | returns ConditionResult, error overload needs a plain bool

function Goon_HasBurningCondition(target)
    target = target or context.Target
    return ConditionResult((Goon_HasBurningCondition_Normal(target) | Goon_HasBurningCondition_Holy(target) | Goon_HasBurningCondition_Hell(target)).Result, { ConditionError("IsNotOnFire") })
end

function Goon_HasBurningConditionOrTag_Normal(target)
    target = target or context.Target
    return ConditionResult((Goon_HasBurningCondition_Normal(target) | Goon_IsKarlachCooking(target)).Result, { ConditionError("IsNotOnFire") })
end

function Goon_HasBurningConditionOrTag(target)
    target = target or context.Target
    return ConditionResult((Goon_HasBurningCondition_Normal(target) | Goon_IsKarlachCooking(target) | Goon_HasBurningCondition_Holy(target) | Goon_HasBurningCondition_Hell(target)).Result, { ConditionError("IsNotOnFire") })
end

-- ==================================== List functions

