-- ==================================== IsSpellChildOrVariantFromContext bug fixing
-- It also checks CombatAIOverrideSpell which is blank for most spells and may give you lots of false positives.
-- For example if there is no spell set in the context, IsSpellChildOrVariantFromContext("Target_HoldMonster") will still return true. So keep that in mind. - From joow.
-- Found in 5e Spells and surely other mods too.

function IsSpellChildOrVariantFromContext(spellId)
  -- No maidens?
  if spellId == "" then
    return ls.thoth.shared.IsSpellChildOrVariantFromContext(spellId)
  end

  -- ong that spell better be more than some quotes fr
  return ls.thoth.shared.IsSpellChildOrVariantFromContext(spellId) & ~ls.thoth.shared.IsSpellChildOrVariantFromContext("")
end

-- ==================================== HasEnemyWithinRange bug fixing
-- Credit to XiphiasRex - Enemies are now filtered properly based on exclusionStatus and tag.
-- TODO: I feel like this could be expanded some, I want to filter better. Saying no to a single status, or yes to a tag is pretty limited.
-- Need to think a bit on how best to differentiate between dudes that actually pose a threat vs ones who don't. Incapacitated exclusions gets a good ways, but it's not everything.
-- TODO: Overwrite the ally one too, give it the better distance check.
-- TODO: Just make a custom version with padding added to custom values.

function HasEnemyWithinRange(exclusionStatus, distance, tag, NumberOfEnemy, target, source)
    target = target or context.Target
    source = source or context.Source
    NumberOfEnemy = NumberOfEnemy or 1
    -- distance = distance or 1.5
    distance = distance or (1.5 + Goon_GetSourceHitBox(false, false, nil, nil, source, target))

    -- local errorTrue = {ConditionError("HasAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    local errorTrue = {ConditionError("Goon_HasEnemyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    -- local errorFalse = {ConditionError("HasNotAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    local errorFalse = {ConditionError("Goon_HasNotEnemyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}

    -- get all enemies in range
    local enemies = GetEnemiesWithinRange(distance, target, source)
    -- if enemies ~= nil then
        -- Only do the check when we are surounded by more than or equal the NumberOfEnemy
        -- if #enemies.Enemies >= NumberOfEnemy then

    -- only both if total enemies is at least desired amount
        if enemies ~= nil and #enemies.Enemies >= NumberOfEnemy then
            local validEnemies = 0

            for _, entity in ipairs(enemies.Enemies) do
                -- ensure entity does not have the excluded status
                local noExcludedStatus = ConditionResult(exclusionStatus == nil)
                if exclusionStatus then
                    noExcludedStatus = ~HasStatus(exclusionStatus, entity)
                end

                -- filter by tag if provided
                local hasTag = ConditionResult(tag == nil)
                if tag then
                    hasTag = Tagged(tag, entity)
                end

            -- increment counter
                if noExcludedStatus.Result and hasTag.Result then
                validEnemies = validEnemies + 1
            end

            -- if at desired amount we done
            if validEnemies >= NumberOfEnemy then
                    return ConditionResult(true, errorFalse, errorTrue)
                -- end
            end
        end
    end
    return ConditionResult(false, errorFalse, errorTrue)
end

-- ==================================== Attack types ====================================
-- Vanilla only has functions for IsWeaponAttack(), IsMainHandAttack(), IsMainHandWeaponAttack(), IsOffHandAttack(), IsMeleeAttack(), IsRangedAttack(), IsUnarmedAttack(), and IsMeleeUnarmedAttack().
-- No such thing as unarmed offhand attacks mechanically(?), even with stuff like Flurry of Blows animations saying otherwise.
-- Some actions and spells use weapon damage but don't have an attack roll, needing to be manually listed or caught another way.

-- Allows any type of attack with a weapon involved, params provided for disabling thrown and spell attacks.
function Goon_IsAttackUsingMeleeWeapon(ignoreThrown, ignoreSpells, source)
    source = source or context.Source
    local weapon = GetAttackWeapon(source)

    if IsMeleeUnarmedAttack().Result then
        return ConditionResult(false)
    end
    if not ignoreThrown and Goon_IsThrownWeaponAttack().Result then
        return ConditionResult(true)
    end
    if ignoreSpells and IsMeleeSpellAttack().Result then
        return ConditionResult(false)
    end
    if not weapon.IsValid then
        return ConditionResult(false)
    end
    if not HasWeaponProperty(WeaponProperties.Melee, weapon).Result then
        return ConditionResult(false)
    end

    return IsMeleeAttack()
end

-- function IsAttackUsingRangedWeapon()
-- No tangible use case, unless I for some unknown reason want to make something only work for throwing bows and shit.

function Goon_IsThrownWeaponAttack()
    return SpellTypeIs(SpellType.Throw) & HasWeaponProperty(WeaponProperties.Melee, context.HitDescription.ThrownObject)
end

function Goon_IsMeleeMainhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.MeleeWeaponAttack)
         | IsSpellChildOrVariantFromContext('Target_MAG_WeaponAction_GrandSlam') -- Actions
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave')
         | IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Melee') -- Spells
         | Goon_IsFlameBladeSpellAttack_Mainhand()
end

function Goon_IsMeleeOffhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.MeleeOffHandWeaponAttack)
         | IsSpellChildOrVariantFromContext('Goon_Target_MAG_WeaponAction_GrandSlam_Offhand') -- Actions
         | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Melee_Offhand') -- Spells
         | Goon_IsFlameBladeSpellAttack_Offhand()
end

function Goon_IsRangedMainhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.RangedWeaponAttack)
         | IsSpellChildOrVariantFromContext('Target_MAG_RetrievingShot') -- Actions
         | IsSpellChildOrVariantFromContext('Zone_ArcaneShot_PiercingArrow')
         | IsSpellChildOrVariantFromContext('Projectile_ArcaneShot_SeekingArrow')
         | IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Ranged') -- Spells
         | IsSpellChildOrVariantFromContext('Projectile_HailOfThorns')
         | IsSpellChildOrVariantFromContext('Projectile_PLA_HailOfThorns_ZhentCave_Gloves')
end

function Goon_IsRangedOffhandWeaponAttack()
    return ConditionResult(context.HitDescription.AttackType == AttackType.RangedOffHandWeaponAttack)
         | IsSpellChildOrVariantFromContext('Goon_Target_MAG_RetrievingShot_Offhand') -- Actions
         | IsSpellChildOrVariantFromContext('Goon_Zone_ArcaneShot_PiercingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_ArcaneShot_SeekingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Ranged_Offhand') -- Spells
         | IsSpellChildOrVariantFromContext('Goon_Projectile_HailOfThorns_Offhand')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_PLA_HailOfThorns_ZhentCave_Gloves_Offhand')
end

-- ==================================== AttackedWithPassiveSourceWeapon() edge cases
-- TODO: IsAttack SpellFlags?

function Goon_IsWeaponActionWithoutAttackRoll()
    return Goon_IsWeaponActionWithoutAttackRoll_Melee()
         | Goon_IsWeaponActionWithoutAttackRoll_Ranged()
         | Goon_IsWeaponActionWithoutAttackRoll_MeleeSpell()
         | Goon_IsWeaponActionWithoutAttackRoll_RangedSpell()
end

function Goon_IsWeaponActionWithoutAttackRoll_Melee()
    return IsSpellChildOrVariantFromContext('Target_MAG_WeaponAction_GrandSlam')                    | IsSpellChildOrVariantFromContext('Goon_Target_MAG_WeaponAction_GrandSlam_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave') | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_Human_Steelwatcher_HellfireCleave_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_ZephyrBreak')                                 | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_ZephyrBreak_Offhand')
         | IsSpellChildOrVariantFromContext('Rush_MAG_ZephyrFlash')                                 | IsSpellChildOrVariantFromContext('Goon_Rush_MAG_ZephyrFlash_Offhand')
end

function Goon_IsWeaponActionWithoutAttackRoll_Ranged()
    return IsSpellChildOrVariantFromContext('Target_MAG_RetrievingShot')                | IsSpellChildOrVariantFromContext('Goon_Target_MAG_RetrievingShot_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_ArcaneShot_PiercingArrow')            | IsSpellChildOrVariantFromContext('Goon_Zone_ArcaneShot_PiercingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_ArcaneShot_SeekingArrow')       | IsSpellChildOrVariantFromContext('Goon_Projectile_ArcaneShot_SeekingArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_SunbeamShot')           | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_SunbeamShot_Offhand')
         | IsSpellChildOrVariantFromContext('Zone_MAG_Automaton_SunbeamShot_Recreate')  | IsSpellChildOrVariantFromContext('Goon_Zone_MAG_Automaton_SunbeamShot_Recreate_Offhand')
end

function Goon_IsWeaponActionWithoutAttackRoll_MeleeSpell()
    return IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Melee') | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Melee_Offhand')
end

function Goon_IsWeaponActionWithoutAttackRoll_RangedSpell()
    return IsSpellChildOrVariantFromContext('Zone_ConjureBarrage_Ranged')                   | IsSpellChildOrVariantFromContext('Goon_Zone_ConjureBarrage_Ranged_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_HailOfThorns')                      | IsSpellChildOrVariantFromContext('Goon_Projectile_HailOfThorns_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_PLA_HailOfThorns_ZhentCave_Gloves') | IsSpellChildOrVariantFromContext('Goon_Projectile_PLA_HailOfThorns_ZhentCave_Gloves_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_LightningArrow')                    | IsSpellChildOrVariantFromContext('Goon_Projectile_LightningArrow_Offhand')
         | IsSpellChildOrVariantFromContext('Projectile_MAG_LightningArrow_Shot')           | IsSpellChildOrVariantFromContext('Goon_Projectile_MAG_LightningArrow_Shot_Offhand')
end

-- ==================================== Spell Target conditions ====================================
-- WIP functions for trying to condense "TargetConditions" as much as possible.
-- TODO: Many more will be made, hard to get a grasp on it before just seeing what would be proper useful to consolidate.
-- TODO: These will probably get moved to their own file, with checks for individual spells groups by level and listed alphabetically.
-- TODO: Check spell type, don't need different functions for projectile vs target.

function Goon_TargetConditions_HarmfulProjectile(target, source)
    target = target or context.Target
    source = source or context.Source
    return Goon_IsPlayerInControl(source) & ~Self(source, target)
         | Goon_IsAIInControl(source) & ~Self(source, target) & (Enemy(target) | Item(target) | Goon_IsSurface())
end

function Goon_TargetConditions_BeneficialProjectile(target, source)
    target = target or context.Target
    source = source or context.Source
    return Goon_IsPlayerInControl(source) & ~Self(source, target)
         | Goon_IsAIInControl(source) & (Character(target) & Ally(target))
end

function Goon_TargetConditions_HarmfulTarget(target, source)
    target = target or context.Target
    source = source or context.Source
    return Goon_IsPlayerInControl(source) & ~Self(source, target) & (Item(target) | Character(target) | Dead(target))
         | Goon_IsAIInControl(source) & (Character(target) & Enemy(target))
end

function Goon_TargetConditions_BeneficialTarget(target, source)
    target = target or context.Target
    source = source or context.Source
    return Goon_IsPlayerInControl(source) & (Item(target) | Character(target) | Dead(target))
         | Goon_IsAIInControl(source) & (Character(target) & Ally(target))
end

-- ==================================== Interrupt conditions ====================================

function Goon_IsAbleToReact(observer, target)
    observer = observer or context.Observer
    target = target or context.Target

    if Goon_IsCrowdControlled_Hard(observer).Result then
        return ConditionResult(false)
    end
    if Dead(observer).Result then
        return ConditionResult(false)
    end
    if Self(target, observer).Result and (IsKillingBlow().Result or HasHPLessThan(1, target).Result) then
        return ConditionResult(false)
    end

    return ConditionResult(true)
end

function Goon_AISafeguardInterruptConditions(ignoreAlliesAndNeutral, source, target, observer)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer

    local isPlayerInControl = Goon_IsPlayerInControl(observer).Result

    if not isPlayerInControl and Tagged('AI_IGNORED_TARGET', target).Result then
        return ConditionResult(false)
    end

    if not isPlayerInControl and HasAnyStatus({ 'SG_Invisible', 'SNEAKING', 'SANCTUARY', 'SANCTUARY_TRANQUILITY' }, {}, {}, observer).Result then
        return ConditionResult(false)
    end

    if ignoreAlliesAndNeutral and not isPlayerInControl then
        return Enemy(source, target)
    end

    return ConditionResult(true)
end

-- I don't think this is as deprecated as the vanilla comment suggest, like, removing it allows me to Sneak Attack boxes dawg.
function Goon_AnyEntityIsItem(source, target, observer)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer

    if Item(source).Result then return ConditionResult(true) end
    if Item(target).Result then return ConditionResult(true) end
    if Item(observer).Result then return ConditionResult(true) end

    if CrowdCharacter(source).Result then return ConditionResult(true) end
    if CrowdCharacter(target).Result then return ConditionResult(true) end
    if CrowdCharacter(observer).Result then return ConditionResult(true) end

    return ConditionResult(false)
end

-- ==================================== Interrupt conditions - "Conditions"
-- AUTOMATED CONTEXT SWAPPING™  - swapContext: Two-party swap, only relevant when observer IS source or IS target.
-- A. Leave (nil)               - auto-detect.
-- B. Force (true)              - force source/target swap, regardless of validity.
-- C. Force (false)             - disable, preserve source/target.

-- DYNAMIC CUCK CONTEXT™        - swapThirdParty: Third-party swap, only relevant when observer is a third party (not source or target) - e.g. Sentinel reacting to an attack on an ally.
-- A. Leave (nil)               - auto-detect; if target is invalid, observer becomes target.
-- B. Force (false)             - disable, preserve source/target.
-- C. Force (true)              - force observer -> source, source -> target swap, regardless of validity or third-party status.

-- CONTEXT WATERFALL™           - Explicit swaps take priority; nil allows automatic resolution where applicable.
-- 1. swapContext == true/false - explicit two-party swap or disable; nil auto-detects via Self().
-- 2. swapThirdParty == true    - explicit third-party swap.
-- 3. swapThirdParty == nil     - fallback for loose third-party context; if target is invalid, observer becomes target.
-- 4. Context resolved          - Positions follow the final resolved entities.

-- NOTE: Only allow the outermost function call to handle context swapping - declare (false, false) for swapContext/swapThirdParty on every internal function called downstream, so it doesn't re-swap already-resolved values.
-- You can leave both nil at the outermost call and let them auto-resolve; it should just work™. However, you'll still need to add guard rails for loose context to suit the use case.
-- If the context is a traditional 1 sided relationship between observer/source or observer/target, you might as well declare a true or false for swapContext respectively.

function Goon_InterruptConditions(source, target, observer)
       source = source or context.Source
       target = target or context.Target
       observer = observer or context.Observer

       if not Goon_IsAbleToReact(observer, target).Result then
           return ConditionResult(false)
       end
       if Goon_AnyEntityIsItem(source, target, observer).Result then
           return ConditionResult(false)
       end

       return ConditionResult(true)
   end

function Goon_BasicHarmfulInterruptConditions(swapContext, swapThirdParty, interruptAttackInProgress, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if not Goon_InterruptConditions(source_, target_, observer).Result then
        return ConditionResult(false)
    end

    local conditions = ~Dead(target_)
                     & ~(IsKillingBlow() | HasHPLessThan(1, target_))
                     & Goon_CanSourceSeeTarget(false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition)
                     & Goon_AISafeguardInterruptConditions(true, source_, target_, observer)

    if source_ ~= target_ then
        conditions = conditions & ~Self(source_, target_)
    end

    if not isThirdPartyFallback then
        conditions = conditions & ~Self(observer, target_) -- & Self(observer, source_) - Cooks UI feedback for OnLeaveAttackRange, somehow?
    end

    if interruptAttackInProgress == true then
        return conditions
    end

    return conditions & (~IsAttack() | HasLastAttackTriggered())
end

-- ==================================== Interrupt conditions - "EnableCondition"
-- data "EnableContext" "OnStatusApplied;OnStatusRemoved"

function Goon_InterruptEnableConditions(allowWildshapes, requiresSight, source)
    source = source or context.Source

    local polymorphConditions = (~HasStatus('SG_Polymorph', source) | Goon_IsUnrestrictedPolymorphStatus(source))
    local blindnessConditions = (~HasStatus('SG_Blinded', source)   | Goon_CanIgnoreBlindness(false, false, true, source))

    if allowWildshapes then
        polymorphConditions = (~HasStatus('SG_Polymorph', source) | Goon_IsNonHostilePolymorphStatus(source))
    end

    if requiresSight then
        return polymorphConditions & blindnessConditions
    end

    return polymorphConditions
end

function Goon_BasicHarmfulInterruptEnableConditions(allowWildshapes, source)
    source = source or context.Source

    return Goon_InterruptEnableConditions(allowWildshapes, true, source)
end

-- ==================================== Interrupt conditions - Attack of Opportunity
-- Note: Enemy(observer, target) in this function instead of Enemy(source, target) breaks the UI warnings for exiting melee range. Don't really get it.
-- Note: Use with Goon_InMeleeAttackRange and Goon_InRangedAttackRange for swapContext. -- TODO: These are probably getting replaced with something better.

function Goon_AttackOfOpportunityConditions(swapContext, swapThirdParty, interruptAttackInProgress, isRanged, isOffhand, ignoreCriticalMissCheck, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if not Goon_BasicHarmfulInterruptConditions(false, false, interruptAttackInProgress, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
        return ConditionResult(false)
    end

    local Conditions = -- & ~WieldingWeapon('Ammunition', false, false, source_)
                       ~HasSpellFlag(SpellFlags.IgnoreAoO, target_)
                     & ~Tagged('OCS_ObjectCharacter', target_)
                     & ~HasAnyStatus({ 'SG_Incapacitated', 'SG_Unconscious' }, {}, {}, source_)
                     & ~HasAnyStatus({ 'SHOCKWAVE', 'SG_Ignore_AOO' }, {}, {}, target_)
                     & ~Goon_HasFlamingSphereAuraCondition(target_)
                     & ~(HasStatus('MOBILE_NO_AOO', source_) & HasStatus('MOBILE_NO_AOO_SOURCE', target_))
                     & ~(HasStatus('FANCYFOOTWORK', source_, target_) & HasStatus('FANCYFOOTWORK_OWNER', target_))
                     & ((~HasStatus('PANACHE', source_)) | (HasStatus('PANACHE', source_) & HasStatus('PANACHE_OWNER', target_)))

    if isSwapped then
        if not Self(observer, source_).Result then
            return ConditionResult(false)
        end
        if not IsAttack().Result then
            return ConditionResult(false)
        end
        if not ignoreCriticalMissCheck and not IsCriticalMiss().Result then
            return ConditionResult(false)
        end

        return Conditions & Goon_InAttackRange(isRanged, isOffhand, false, false, nil, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition)
    end

    return Conditions & Enemy(source_, target_)
                      & ~Goon_IsAction()
end

-- ==================================== Interrupt conditions - Sneak Attack
-- Goon_IsSpellDamageTypePhysical() for the druid shit, if not for unreliable DamageType usage...
-- Add IsCritical() or not IsCritical() as needed, after the function calls.
-- Note: Rakish stuff is 5e RAW, not whatever vanilla was trying and failing to do.
-- TODO: Custom HasAdvantage and HasDisadvantage functions with context in args.

function Goon_SneakAttackInterruptConditions(source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    return Goon_BasicHarmfulInterruptConditions(false, false, true, source, target, observer, sourcePosition, targetPosition, observerPosition)
        & Self(observer, source)
        & ~Tagged('INANIMATE', target)
        & IsHit()
        & ~HasDamageEffectFlag(DamageFlags.AttackDisadvantage)
        & ~Goon_IsSneakAttack()
        & ((WieldingFinesseWeaponInSpecificHand(observer,false) & IsMainHandWeaponAttack())
        | (WieldingFinesseWeaponInSpecificHand(observer,true) & IsOffHandAttack())
        | (SpellTypeIs(SpellType.Throw) & (HasWeaponProperty(WeaponProperties.Finesse, context.HitDescription.ThrownObject)
        | HasPassive('SneakAttack_LLRuffian', source) & ~HasWeaponProperty(WeaponProperties.Twohanded, context.HitDescription.ThrownObject) & HasWeaponProperty(WeaponProperties.Melee, context.HitDescription.ThrownObject))) -- IsThrowAttackRoll()
        | (WieldingWeapon('Ammunition', false, true, observer) & IsRangedWeaponAttack())
        | (Goon_IsDruidWildshape(observer) & (IsMeleeAttack() | IsRangedAttack()) & (IsDamageTypePiercing() | IsDamageTypeSlashing() | IsDamageTypeBludgeoning()))
        | (HasPassive('SneakAttack_LLRuffian', source) & (IsMainHandAttack() | IsMonkWeaponAttack())))
        & (HasDamageEffectFlag(DamageFlags.AttackAdvantage) | HasAllyWithinRange('SG_Incapacitated',nil,nil,nil, target,source)
        | ((HasPassive('RakishAudacity', source) | HasPassive('DWE_RakishAudacity', source))
        & (~HasAllyWithinRange(nil,nil,nil,nil, observer,source) & ~HasEnemyWithinRange(nil,nil,nil,2, observer,source)) & Goon_DistanceCheck(1.5, false, false, false, false, source, target, observer, sourcePosition, targetPosition, observerPosition)))
end

-- Sneak Attack action "TargetConditions"
-- TODO: The default error message of "Must have Advantage against the target" is not accurate to mechanics - at least for the Rakish versions.
function Goon_SneakAttackTargetConditions_Melee(target, source, sourcePosition, targetPosition)
    target = target or context.Target
    source = source or context.Source
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition

    return Character(target) & ~Self(source, target) & ~Dead(target) & ~Tagged('INANIMATE', target)
         & (~HasDisadvantage(AttackType.MeleeWeaponAttack))
         & ((HasAdvantage(AttackType.MeleeWeaponAttack) | HasAllyWithinRange('SG_Incapacitated',nil,nil,nil, target,source))
         | ((HasPassive('RakishAudacity', source) | HasPassive('DWE_RakishAudacity', source)) 
         & (~HasAllyWithinRange(nil,nil,nil,nil, source,source) & ~HasEnemyWithinRange(nil,nil,nil,2, source,source)) & Goon_DistanceCheck(1.5, false, false, false, false, source, target, nil, sourcePosition, targetPosition, nil)))
end

function Goon_SneakAttackTargetConditions_Ranged(target, source, sourcePosition, targetPosition)
    target = target or context.Target
    source = source or context.Source
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition

    return Character(target) & ~Self(source, target) & ~Dead(target) & ~Tagged('INANIMATE', target)
         & (~HasDisadvantage(AttackType.RangedWeaponAttack))
         & ((HasAdvantage(AttackType.RangedWeaponAttack) | HasAllyWithinRange('SG_Incapacitated',nil,nil,nil, target,source))
         | ((HasPassive('RakishAudacity', source) | HasPassive('DWE_RakishAudacity', source)) 
         & (~HasAllyWithinRange(nil,nil,nil,nil, source,source) & ~HasEnemyWithinRange(nil,nil,nil,2, source,source)) & Goon_DistanceCheck(1.5, false, false, false, false, source, target, nil, sourcePosition, targetPosition, nil)))
end

function Goon_SneakAttackTargetConditions_Unarmed(target, source)
    target = target or context.Target
    source = source or context.Source

    return Character(target) & ~Self(source, target) & ~Dead(target) & ~Tagged('INANIMATE', target)
         & (~HasDisadvantage(AttackType.MeleeUnarmedAttack))
         & (HasAdvantage(AttackType.MeleeUnarmedAttack) | HasAllyWithinRange('SG_Incapacitated',nil,nil,nil, target,source))
end

-- ==================================== Player vs NPC checks + in control vs not in control ====================================
-- TODO: Check for edge cases where an AI controlled character might be a "Player", or find a better means of checking this stuff.

function Goon_IsPlayerInControl(source)
    source = source or context.Source
    return Player(source) & ~Goon_IsEntityDominated(source) & ~Goon_IsEntityMad(source)
end

function Goon_IsAIInControl(source)
    source = source or context.Source
    return (Player(source) & Goon_IsEntityDominated(source) | ~Player(source)) & ~Goon_IsEntityMad(source)
end

function Goon_IsEntityMad(source)
    source = source or context.Source
    return HasAnyStatus({ 'SG_Mad' }, {}, {}, source)
end

function Goon_IsEntityDominated(source)
    source = source or context.Source
    return HasAnyStatus({ 'SG_Dominated', 'SG_Possessed' }, {}, {}, source)
end

-- ==================================== Range/Distance checks ====================================
-- 🚨📏⚠️ CHAT DO NOT SELL DistanceToEntityHitBounds ⚠️📏🚨
-- 🗣️ "yo can i hit this mf?"
-- ⬇️
-- 🔥 DistanceToEntityHitBounds 🔥

-- ✅ actual bonk range 🗡️
-- ✅ hitbox gaming 📦
-- ✅ no fake centre-point nonsense 🤡
-- ✅ giga creatures get measured properly 🦖

-- ❌ stop doing goofy ahh distance math 🧮💀

-- DistanceToEntityHitBounds = 🐐📏✨

-- TODO: Elevation offset can kinda fuck with the tight values, but I don't know where to begin with that shit...
-- Note: Can be made less expensive by handing down values from outer functions instead of redoing math.
function Goon_GetSourceHitBox(swapContext, swapThirdParty, precomputedCentreToCentre, precomputedTargetCentreToSourceEdge, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if not source_.IsValid then
        return .5
    end

    local centreToCentre = precomputedCentreToCentre or Distance(sourcePosition_, targetPosition_)
    local targetCentreToSourceEdge = precomputedTargetCentreToSourceEdge or DistanceToEntityHitBounds(targetPosition_, source_)

    return centreToCentre - targetCentreToSourceEdge
end

function Goon_DistanceCheck(value, greaterThan, disableHitBoxPadding, swapContext, swapThirdParty, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    local centreToCentre = Distance(sourcePosition_, targetPosition_)
    local sourceCentreToTargetEdge = DistanceToEntityHitBounds(sourcePosition_, target_)
    local paddedValue = value

    if disableHitBoxPadding ~= true then
        paddedValue = value + Goon_GetSourceHitBox(false, false, centreToCentre, nil, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition)
    end

    local result = result
    local errorPrefix = errorPrefix

    if greaterThan then
        result = sourceCentreToTargetEdge >= paddedValue or centreToCentre >= paddedValue
        errorPrefix = "Goon_DistanceEqualOGreaterThan"
    else
        result = sourceCentreToTargetEdge <= paddedValue or centreToCentre <= paddedValue
        errorPrefix = "Goon_DistanceEqualOrLessThan"
    end

    local errorTrue = {ConditionError(errorPrefix .. "_True", {ConditionErrorData.MakeFromNumber(value, EErrorDataType.Distance)})}
    local errorFalse = {ConditionError(errorPrefix .. "_False", {ConditionErrorData.MakeFromNumber(value, EErrorDataType.Distance)})}

    return ConditionResult(result, errorFalse, errorTrue)
end

-- EXAMPLE usage in interrupt conditions:
-- "Goon_BasicHarmfulInterruptConditions(true) and Goon_InAttackRange(false,true)"

function Goon_InAttackRange(isRanged, offhand, swapContext, swapThirdParty, distance, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    local weapon = weapon
    local isHandCrossbow = isHandCrossbow
    local isReachWeapon = isReachWeapon

    if distance == nil then
        local defaultWeaponRange = 1.5
        local reachWeaponRange = 2.5
        local defaultRangedRange = 18
        local handCrossbowRange = 15

        if isRanged then
            distance = defaultRangedRange
        else
            distance = defaultWeaponRange
        end

        local slot = slot

        if isRanged then
            if offhand then
                slot = EquipmentSlot.RangedOffHand
            else
                slot = EquipmentSlot.RangedMainHand
            end
        else
            if offhand then
                slot = EquipmentSlot.MeleeOffHand
            else
                slot = EquipmentSlot.MeleeMainHand
            end
        end

        weapon = GetItemInEquipmentSlot(slot, source_)

        if weapon.IsValid then
            isHandCrossbow = Tagged('WPN_HAND_CROSSBOW', weapon).Result
            isReachWeapon = HasWeaponProperty(WeaponProperties.Reach, weapon).Result

            if isRanged then
                if isHandCrossbow then
                    distance = handCrossbowRange
                end
            else
                if isReachWeapon then
                    distance = reachWeaponRange
                end
            end
        end
    end

    return Goon_DistanceCheck(distance, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition)
end

-- ==================================== STATUS GROUPINGS ETC. ====================================

-- ==================================== CanAttack

-- Mirrors CanAttack with ActionPoint.
function Goon_CanAttack_Offhand(target)
    local target = target or context.Target
    local result = HasActionResource('BonusActionPoint', 1, 0, false, false, target)
    return ConditionResult(result.Result,{ConditionError("IsCanNotAttack")})
end

-- ==================================== Encumbered

function Goon_IsEncumbered(target)
    local target = target or context.Target
    return HasAnyStatus({ 'ENCUMBERED_LIGHT', 'ENCUMBERED_HEAVY', 'ENCUMBERED_MAX' }, {}, {}, target)
end

-- ==================================== Metal

function Goon_IsMetal(target)
    target = target or context.Target

    if IsMetalItem(target).Result               then return ConditionResult(true) end
    if HasMetalWeaponInAnyHand(target).Result   then return ConditionResult(true) end
    if HasMetalArmor(target).Result             then return ConditionResult(true) end
    if IsMetalCharacter(target).Result          then return ConditionResult(true) end

    return ConditionResult(false)
end

-- ==================================== Non-lethal

function Goon_IsAbleToBeKnockedOut(target, source)
    source = source or context.Source
    target = target or context.Target

    return Character(target) & ~Self(source, target) & ~Summon(target) 
         & ~Tagged('UNDEAD', target) & ~Tagged('CONSTRUCT', target) & ~Tagged('CREATURE_SPORE_SERVANT', target)
         & (~HasAnyStatus({ 'SG_Polymorph' }, {}, {}, target) | Goon_IsUnrestrictedPolymorphStatus(target)) 
         & ~HasAnyStatus({ 'HAG_DISGUISE', 'HAG_DISGUISE_PIG', 'HAG_DISGUISE_SHEEP' }, {}, {}, target)
         & ~IsImmuneToStatus('KNOCKED_OUT', target, source)
end

-- ==================================== Crowd Control
-- SG_Restrained blocking loads of interrupts with IsAbleToReact is a bit silly.

function Goon_IsCrowdControlled(target)
    local target = target or context.Target
    return Goon_IsCrowdControlled_Hard(target) | Goon_IsCrowdControlled_Soft(target)
end

function Goon_IsCrowdControlled_Hard(target)
    local target = target or context.Target
    return HasAnyStatus({ 'SG_Fleeing', 'SG_Incapacitated', 'SG_Stunned', 'SG_Unconscious', 'SG_Petrified' }, {}, {}, target)
         | ~Goon_IsNonHostilePolymorphStatus(target)
end

function Goon_IsCrowdControlled_Soft(target)
    local target = target or context.Target
    return HasAnyStatus({ 'SG_Restrained' }, {}, {}, target)
end

-- ==================================== Bleeding

function Goon_HasBleedingCondition(target)
    target = target or context.Target
    return HasAnyStatus({ 'BLEEDING', 'BARBED_ARROW', 'HEAVY_BLEEDING' }, {}, {}, target)
end

-- ==================================== Silenced/Deafened

-- TODO: GOON_SILENCED_AURA: not in the lua, intentional?
function Goon_HasSilencedCondition(target)
    target = target or context.Target
    return HasAnyStatus({ 'SILENCED', 'SHA_SILENTLIBRARY_LIBRARIANSILENCE_STATUS', 'LOW_VoicelessPenitent_Silenced', 'SILENCED_MOVEMENT', 'GARROTE_SILENCED' }, {}, {}, target)
end

function Goon_HasDeafenedCondition(target)
    target = target or context.Target
    return HasAnyStatus({ 'DEAFENED', 'DEAF', 'DEAFNESS', 'GOON_DEAFENED', 'GOON_REAL_INJURY_GRIT_GLORY_DEAFNESS', 'GOON_REAL_INJURY_GRIT_GLORY_PARTIAL_DEAFNESS' }, {}, {}, target) | HasPassive('Deafness', target)
end

function Goon_SavingThrow_SoundBased(ability, dc, advantage, disadvantage, target)
    advantage = advantage or false
    disadvantage = disadvantage or false
    target = target or context.Target

    if not Goon_HasDeafenedCondition(target).Result then
        local st = SavingThrow(ability, dc, advantage, disadvantage, target)
        return ConditionResult(st.Result, {}, {}, st.Chance)
    else
        return ConditionResult(true)
    end
end

-- ==================================== Prone
-- "Target_ExtractBrain_Mindflayer" has some dumb shit going on, and why is there such overlap between prone and unconscious anyway?
-- TODO: Unfuck prone I guess.

function Goon_HasProneCondition_Conscious(target)
    target = target or context.Target
    return HasAnyStatus({ 'PRONE','PRONE_GREASE','PRONE_ICE','PRONE_FALLEN','PRONE_THUNDEROUS_SMITE' }, {}, {}, target)
end

function Goon_HasProneCondition_Unconscious(target)
    target = target or context.Target
    return HasStatus('SG_Prone', target) & HasStatus('SG_Unconscious', target) & ~Goon_HasProneCondition_Conscious(target)
end

