-- ==================================== "SpellDamageTypeIs" "DamageTypes" checks
-- Functions for "SpellDamageTypeIs" "DamageTypes" checks, not to be confused with damage dealt.
-- TODO: Support spell damage type transmutation.

function Goon_IsSpellWithoutDamageType(source, target)
    source = source or context.Source
    target = target or context.Target
    return ~Goon_IsSpellDamageTypeAcid(source, target, true, true)
         & ~Goon_IsSpellDamageTypeCold(source, target, true, true)
         & ~Goon_IsSpellDamageTypeFire(source, target, true, true)
         & ~Goon_IsSpellDamageTypeLightning(source, target, true, true)
         & ~Goon_IsSpellDamageTypeThunder(source, target, true, true)
         & ~Goon_IsSpellDamageTypeRadiant(source, target, true, true)
         & ~Goon_IsSpellDamageTypePoison(source, target, true, true)
         & ~Goon_IsSpellDamageTypePsychic(source, target, true, true)
         & ~Goon_IsSpellDamageTypeNecrotic(source, target, true, true)
         & ~Goon_IsSpellDamageTypeForce(source, target, true, true)
         & ~Goon_IsSpellDamageTypeSlashing(source, target, true, true)
         & ~Goon_IsSpellDamageTypePiercing(source, target, true, true)
         & ~Goon_IsSpellDamageTypeBludgeoning(source, target, true, true)
end

-- These remain gated, and remain the public API with the two ignore flags.
function Goon_IsSpellDamageTypePhysical(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return Goon_IsSpellDamageTypeSlashing(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
         | Goon_IsSpellDamageTypePiercing(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
         | Goon_IsSpellDamageTypeBludgeoning(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

function Goon_IsSpellDamageTypeElemental(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return Goon_IsSpellDamageTypeAcid(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
         | Goon_IsSpellDamageTypeCold(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
         | Goon_IsSpellDamageTypeFire(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
         | Goon_IsSpellDamageTypeLightning(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
         | Goon_IsSpellDamageTypeThunder(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

function Goon_IsSpellDamageTypeAcid(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return SpellDamageTypeIs(DamageType.Acid) & Goon_IsSpellDealingFunctorDamage(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

function Goon_IsSpellDamageTypeCold(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return SpellDamageTypeIs(DamageType.Cold) & Goon_IsSpellDealingFunctorDamage(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

function Goon_IsSpellDamageTypeFire(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return SpellDamageTypeIs(DamageType.Fire) & Goon_IsSpellDealingFunctorDamage(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

function Goon_IsSpellDamageTypeLightning(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return SpellDamageTypeIs(DamageType.Lightning) & Goon_IsSpellDealingFunctorDamage(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

function Goon_IsSpellDamageTypeThunder(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target
    return SpellDamageTypeIs(DamageType.Thunder) & Goon_IsSpellDealingFunctorDamage(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
end

