-- Similar check, but returning the actual number.
function Goon_GetHighestAbilityValue(abilities, source)
    source = source or context.Source
    local highestValue = 0

    for _, ability in ipairs(abilities) do
        if source[ability] > highestValue then
            highestValue = source[ability]
        end
    end
    return highestValue
end
