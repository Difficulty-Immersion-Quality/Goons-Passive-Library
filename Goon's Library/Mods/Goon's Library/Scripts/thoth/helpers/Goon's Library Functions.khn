    target = target or context.Target
    return HasAnyStatus({ 'BURNING', 'BURNING_AZER', 'BURNING_LAVA', 'BURNING_TRAPWALL', 'FLAMING_SPHERE_AURA', 'FLAMING_SPHERE_AURA_3', 'FLAMING_SPHERE_AURA_4', 'FLAMING_SPHERE_AURA_5', 'FLAMING_SPHERE_AURA_6', 'FLAMING_SPHERE_AURA_7', 'FLAMING_SPHERE_AURA_8', 'FLAMING_SPHERE_AURA_9', 'FLAMING_SPHERE', 'FLAMING_SPHERE_3', 'FLAMING_SPHERE_4', 'FLAMING_SPHERE_5', 'FLAMING_SPHERE_6', 'FLAMING_SPHERE_7', 'FLAMING_SPHERE_8', 'FLAMING_SPHERE_9', 'HAV_MAG_INFERNAL_FIRE', 'LOW_HOH_BOAR_BURNING_DAMAGE', 'MAG_FIRE_HEAT', 'MAG_INFERNAL_BURNING', 'ORI_KARLACH_ENRAGE', 'ORI_KARLACH_INFERNAL_FURY', 'SEARING_SMITE', 'WILD_MAGIC_BURNING' }, {}, {}, target)
end

function Goon_HasBurningCondition_Holy(target)
    target = target or context.Target
    return HasAnyStatus({ 'BURNING_HOLY' }, {}, {}, target)
end

function Goon_HasBurningCondition_Hell(target)
    target = target or context.Target
    return HasAnyStatus({ 'BURNING_HELLFIRE' }, {}, {}, target)
end

function Goon_IsKarlachCooking(target)
    target = target or context.Target
    return Tagged('REALLY_KARLACH', target) & ~Tagged('KARLACH_CAN_TOUCH', target)
end

function Goon_HasFlamingSphereAuraCondition(target)
    target = target or context.Target
    return HasAnyStatus({ 'FLAMING_SPHERE_AURA', 'FLAMING_SPHERE_AURA_3', 'FLAMING_SPHERE_AURA_4', 'FLAMING_SPHERE_AURA_5', 'FLAMING_SPHERE_AURA_6', 'FLAMING_SPHERE_AURA_7', 'FLAMING_SPHERE_AURA_8', 'FLAMING_SPHERE_AURA_9' }, {}, {}, target)
end

-- ==================================== Fetch character levels ====================================

function Goon_CharacterLevelEqualTo(value, source)
    source = source or context.Source
    return ConditionResult(source.Level == value)
end

function Goon_CharacterLevelEqualToOrGreaterThan(value, source)
    source = source or context.Source
    return ConditionResult(source.Level >= value)
end

function Goon_CharacterLevelEqualToOrGreaterThan_5(source)
    source = source or context.Source
    return ConditionResult(source.Level >= 5)
end

function Goon_CharacterLevelGreaterThan(value, source)
    source = source or context.Source
    return ConditionResult(source.Level > value)
end

function Goon_CharacterLevelLessThan(value, source)
    source = source or context.Source
    return ConditionResult(source.Level < value)
end

function Goon_CharacterLevelGreaterThanOrEqual(value, source)
    source = source or context.Source
    return ConditionResult(source.Level >= value)
end

function Goon_CharacterLevelLessThanOrEqual(value, source)
    source = source or context.Source
    return ConditionResult(source.Level <= value)
end

function Goon_IsCharacterLevelEqualOrBetween(value, value2, source)
    source = source or context.Source
    return Goon_CharacterLevelGreaterThanOrEqual(value, source) & Goon_CharacterLevelLessThanOrEqual(value2, source)
end

-- ==================================== Ability modifier not a negative value ====================================
-- Functions to ensure ability modifiers aren't negative values when doing scaling bonuses

function Goon_IsStrengthModifierPositive(source)
    source = source or context.Source
    return GetModifier(source.Strength) > 0
end

function Goon_IsDexterityModifierPositive(source)
    source = source or context.Source
    return GetModifier(source.Dexterity) > 0
end

function Goon_IsConstitutionModifierPositive(source)
    source = source or context.Source
    return GetModifier(source.Constitution) > 0
end

function Goon_IsIntelligenceModifierPositive(source)
    source = source or context.Source
    return GetModifier(source.Intelligence) > 0
end

function Goon_IsWisdomModifierPositive(source)
    source = source or context.Source
    return GetModifier(source.Wisdom) > 0
end

function Goon_IsCharismaModifierPositive(source)
    source = source or context.Source
    return GetModifier(source.Charisma) > 0
end

-- ==================================== Check current duration of status ====================================

function Goon_StatusGroupDurationEqualTo(target, stringStatusGroupName, value)
    target = target or context.Target
    value = value or 0
    return ConditionResult(math.floor(GetStatusDuration(stringStatusGroupName, target)) == value)
end

-- ==================================== Spell batching ====================================
-- TODO: Referencing the interrupts below doesn't really work the same as spells, e.g. OnDamage contexts for functors.
-- Best course of action is likely to have the interrupts UseSpell, replacing animations with the instant cast one. "Target_NULLSPELL"?
-- "I think context.InterruptId is only for the interrupt RollConditions" - Joow

function Goon_IsAction()
    return IsAttack()
         | IsSpell()
         | SpellTypeIs(SpellType.Zone)
         | SpellTypeIs(SpellType.Projectile)
         | SpellTypeIs(SpellType.ProjectileStrike)
         | SpellTypeIs(SpellType.Rush)
         | SpellTypeIs(SpellType.Shout)
         | SpellTypeIs(SpellType.Target)
         | SpellTypeIs(SpellType.Teleportation)
         | SpellTypeIs(SpellType.Wall)
         | SpellTypeIs(SpellType.Throw)
end

-- ==================================== Sanctuary
-- Spells that need manually specifying in "SanctuarySpecificSpell", for removal of the caster's Sanctuary.
-- TODO: Couldn't these spells just have IsHarmful?
-- TODO: It's a little awkward, I think the way this is implemented in the vanilla passive could be expanded more.
-- Could probably track if surfaces and walls and whatever do damage, instead of the cast. Could see if statuses were applied to enemies after the cast.
-- Does "DealDamage(SWAP" not get counted for OnDamage?

function Goon_IsSanctuarySpecificSpell()
    return IsSpellChildOrVariantFromContext('Wall_BladeBarrier')
         | IsSpellChildOrVariantFromContext('Target_Polymorph')
         | IsSpellChildOrVariantFromContext('Target_HungerOfHadar')
         | IsSpellChildOrVariantFromContext('Target_Banishment')
         | IsSpellChildOrVariantFromContext('Zone_Fear')
         | IsSpellChildOrVariantFromContext('Target_FleshToStone')
         | IsSpellChildOrVariantFromContext('Target_HypnoticPattern')
         | IsSpellChildOrVariantFromContext('Target_Slow')
         | IsSpellChildOrVariantFromContext('Target_StinkingCloud')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Acid')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Cold')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Fire')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Lightning')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Thunder')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Detonation')
         | IsSpellChildOrVariantFromContext('Target_GlyphOfWarding_Sleep')
         | IsSpellChildOrVariantFromContext('Target_Moonbeam')
         | IsSpellChildOrVariantFromContext('Target_Moonbeam_Move')
        --  | IsSpellChildOrVariantFromContext('Target_CreateWater')
        --  | IsSpellChildOrVariantFromContext('Target_CreateWater_StaffOfRain')
        --  | IsSpellChildOrVariantFromContext('Target_CreateWater_NPC')
        --  | IsSpellChildOrVariantFromContext('Target_CreateWater_MinorConjuration')
        --  | IsSpellChildOrVariantFromContext('Target_MAG_Umberlee_CreateWater')
        --  | IsSpellChildOrVariantFromContext('Target_CreateDestroyWater')
        --  | IsSpellChildOrVariantFromContext('Target_MAG_Umberlee_CreateDestroyWater')
         | IsSpellChildOrVariantFromContext('Target_SleetStorm')
end

-- ==================================== Revivify

function Goon_IsRevivifySpell()
    return IsSpellChildOrVariantFromContext('Teleportation_Revivify')
         | IsSpellChildOrVariantFromContext('Teleportation_Revivify_Scroll')
         | IsSpellChildOrVariantFromContext('Teleportation_TrueResurection_Scroll')
         | IsSpellChildOrVariantFromContext('Teleportation_Revivify_Deva')
         | IsSpellChildOrVariantFromContext('Teleportation_MAG_Revivify') 
end

-- ==================================== Sneak Attacks

function Goon_HasUniqueSneakAttack(source)
    source = source or context.Source
    return HasPassive('RakishAudacity', source)
         | HasPassive('SneakAttack_LLRuffian', source)
end

function Goon_IsSneakAttack()
    return HasUseCosts('SneakAttack_Charge')
         | Goon_IsSneakAttackSpell()
         | Goon_IsSneakAttackInterrupt()
end

function Goon_IsSneakAttackSpell()
    return IsSpellChildOrVariantFromContext('Target_SneakAttack')
         | IsSpellChildOrVariantFromContext('Projectile_SneakAttack')
         | IsSpellChildOrVariantFromContext('Target_SneakAttack_Rakish')
         | IsSpellChildOrVariantFromContext('Projectile_SneakAttack_Rakish')
         | IsSpellChildOrVariantFromContext('Target_SneakAttack_Swarm')
         | IsSpellChildOrVariantFromContext('Target_SneakAttack_Ruffian')
         | IsSpellChildOrVariantFromContext('Projectile_SneakAttack_Ruffian')
         | IsSpellChildOrVariantFromContext('Target_LLRuffian_SneakAttack_Unarmed')
         | IsSpellChildOrVariantFromContext('Target_LHB_Justicar_ConsecratedStrike')
         | IsSpellChildOrVariantFromContext('Projectile_LHB_Justicar_ConsecratedStrike')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_SneakAttack')
        --  GFB Sneak Attack and others?
end

function Goon_IsSneakAttackInterrupt()
    return Goon_IsUACunningStrikeSneakAttack()
           -- _Critical, _Rakish, _Rakish_Critical, _Ruffian, _Ruffian_Critical
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_SneakAttack') ~= nil)
           -- _2 .. _9 and _Critical, _Critical_2 .. _9
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_LHB_Justicar_ConsecratedStrike') ~= nil)
end

function Goon_IsUACunningStrikeSneakAttack()
    return ConditionResult(string.match(context.InterruptId, '^Goon_Interrupt_DWE_SneakAttack') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_DWE_SneakAttack') ~= nil)
           -- _Less1, _Less2, _Less3, _Less6, _Disarm, _Poison, Goon_ _Poison, _Trip, _Withdraw, _Daze, _KnockOut, _Obscure
         | ConditionResult(string.match(context.InterruptId, 'Interrupt_DWE_CunningStrike') ~= nil)
end

-- ==================================== Flourishes

-- TODO: Fill this out with the custom reactions and temporary spells!
function Goon_IsFlourish()
    return Goon_IsFlourishSpell()
         | Goon_IsFlourishTemporarySpell()
         | Goon_IsFlourishInterrupt()
end

function Goon_IsFlourishSpell()
    return IsSpellChildOrVariantFromContext('Target_BladeFlourish_Defensive')
         | IsSpellChildOrVariantFromContext('Projectile_BladeFlourish_Defensive')
         | IsSpellChildOrVariantFromContext('Target_BladeFlourish_Mobile')
         | IsSpellChildOrVariantFromContext('Projectile_BladeFlourish_Mobile')
         | IsSpellChildOrVariantFromContext('Zone_BladeFlourish_Slashing')
         | IsSpellChildOrVariantFromContext('Projectile_BladeFlourish_Slashing')
end

function Goon_IsFlourishTemporarySpell()
    return IsSpellChildOrVariantFromContext('Goon_Target_BladeFlourish_Defensive_Temporary')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_BladeFlourish_Defensive_Temporary')
         | IsSpellChildOrVariantFromContext('Goon_Target_BladeFlourish_Mobile_Temporary')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_BladeFlourish_Mobile_Temporary')
         | IsSpellChildOrVariantFromContext('Goon_Target_BladeFlourish_Slashing_Temporary')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_BladeFlourish_Slashing_Temporary')
         | IsSpellChildOrVariantFromContext('Goon_Throw_BladeFlourish_Slashing_Temporary')
end

function Goon_IsFlourishInterrupt()
    return -- _Defensive, _Mobile, _Slashing
           ConditionResult(string.match(context.InterruptId, '^Goon_Interrupt_BladeFlourish_') ~= nil)
end

-- ==================================== Bardic Inspiration

function Goon_IsBardicInspirationSpell()
    return IsSpellChildOrVariantFromContext('Target_BardicInspiration')
         | IsSpellChildOrVariantFromContext('Target_BardicInspiration_2')
         | IsSpellChildOrVariantFromContext('Target_BardicInspiration_Combat')
         | IsSpellChildOrVariantFromContext('Target_BardicInspiration_Combat_2')
         | IsSpellChildOrVariantFromContext('Target_MantleOfInspiration')
         | IsSpellChildOrVariantFromContext('Target_MantleOfInspiration_2')
         | IsSpellChildOrVariantFromContext('Target_MantleOfInspiration_3')
         | IsSpellChildOrVariantFromContext('Shout_BardicInspiration_PeerlessSkill')
end

-- ==================================== Sorcerer stuff

function Goon_IsCreateSorceryPoints()
    return IsSpellChildOrVariantFromContext('Shout_CreateSorceryPoints')
         | IsSpellChildOrVariantFromContext('Shout_CreateSorceryPoints_1')
         | IsSpellChildOrVariantFromContext('Shout_CreateSorceryPoints_2')
         | IsSpellChildOrVariantFromContext('Goon_Shout_CreateSorceryPoints_Warlock')
         | IsSpellChildOrVariantFromContext('Goon_Shout_CreateSorceryPoints_Warlock_1')
         | IsSpellChildOrVariantFromContext('Goon_Shout_CreateSorceryPoints_Warlock_2')
end

-- ==================================== Smites

function Goon_IsDivineSmite()
    return IsSpellChildOrVariantFromContext('Target_Smite_Divine')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Unlock')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Critical_Unlock')
        -- Paladin and Oaths DnD 5R PHB2024 by ChizFreak
         | IsSpellChildOrVariantFromContext('Target_PPHB2024_Smite_Divine_Free')
         | IsSpellChildOrVariantFromContext('Target_PPHB2024_Smite_Divine_Free_Melee')
         | IsSpellChildOrVariantFromContext('Target_PPHB2024_Smite_Divine_Free_Unarmed')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Unarmed')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Unarmed') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Unarmed_Unlock')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Unarmed_Critical_Unlock')
         | IsSpellChildOrVariantFromContext('Target_RWI_Smite_Divine') -- I dunno, it's there in the khn anyway
        --  Unholy Smite for Oathbreakers by ChizFreak
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_CHIZ_Unholy_Smite') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite_Unlock')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite_Unlock_Critical')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite_Unarmed_Unlock')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite_Unarmed_Unlock_Critical')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite_Free')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_TEST_SMITE')
         | IsSpellChildOrVariantFromContext('Target_RWI_CHIZ_Unholy_Smite')
        -- Unholy Smite - Empowering Oathbreakers (And Other Paladin Subclasses) by GraphicFade  
         | IsSpellChildOrVariantFromContext('Target_Smite_Unholy_Oathbreaker')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Unholy_Oathbreaker') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Unholy_Oathbreaker_Unlock')
         | IsSpellChildOrVariantFromContext('Target_Smite_Unholy_OB_Reaction')
        -- Beyond Divine Smite by GraphicFade
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Acid')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Acid') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Acid') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Chaos')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Chaos') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Chaos') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Cold')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Cold') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Cold') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Fire')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Fire') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Fire') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Force')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Force') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Force') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Lightning')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Lightning') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Lightning') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Necro')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Necro') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Necro') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Poison')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Poison') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Poison') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Psychic')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Psychic') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Psychic') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Thunder')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Thunder') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_Thunder') ~= nil)
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_War')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_War') ~= nil)
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Divine_Critical_War') ~= nil)
        -- Blackguard smites by Xarara
        -- TODO: Add support for Hell Knight and Death Knight subclass variants if they get released.
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_PROFANE') 
         | ConditionResult(string.match(context.InterruptId, '^INTERRUPT_SMITE_PROFANE') ~= nil)
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_PROFANE_BLOOD') 
         | ConditionResult(string.match(context.InterruptId, '^INTERRUPT_SMITE_PROFANE_BLOOD') ~= nil)
        -- Mizora's Rewards by malonkey1
         | IsSpellChildOrVariantFromContext('Target_Smite_Eldritch')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Eldritch') ~= nil)
        -- Oathbreaker Reborn by K_Constantine and faceplug
         | IsSpellChildOrVariantFromContext('Target_Smite_Malicious')
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Malicious') ~= nil)
end

function Goon_IsSmiteSpells()
    return Goon_IsDivineSmite()
        -- Banishing Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Banishing')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Banishing')
        -- Blinding Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Blinding')
        -- Branding Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Branding')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Branding')
         | IsSpellChildOrVariantFromContext('Target_Smite_Branding_ZarielTiefling')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Branding_ZarielTiefling')
        -- Searing Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Searing')
         | IsSpellChildOrVariantFromContext('Target_Smite_Searing_ZarielTiefling')
         | IsSpellChildOrVariantFromContext('Target_FOR_Smite_Searing_DeathOfATrueSoul')
         | IsSpellChildOrVariantFromContext('Target_UND_Smite_Searing_DuergarBlacksmithHammer')
         | IsSpellChildOrVariantFromContext('Goon_Target_UND_Smite_Searing_DuergarBlacksmithHammer_Offhand')
        -- Staggering Smite
         | IsSpellChildOrVariantFromContext('Target_StaggeringSmite')
        -- Thunderous Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Thunderous')
         | IsSpellChildOrVariantFromContext('Target_MAG_ThunderousSmite')
        -- Wrathful Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Wrathful')
         | IsSpellChildOrVariantFromContext('Target_MAG_Smite_Wrathful')
        -- Lunar Smite - Vanilla and Xarara's Lunar Smite mod
         | IsSpellChildOrVariantFromContext('Target_LunarSmite')
         | IsSpellChildOrVariantFromContext('Target_MOO_Nightsong_SearingSmite')
         | IsSpellChildOrVariantFromContext('Target_LOW_RamazithsTower_Nightsong_Smite')
        -- Veenab stuff
         | IsSpellChildOrVariantFromContext('VBT_Spell_0_SappingBlade')
         | IsSpellChildOrVariantFromContext('VBT_Spell_2_DrainingSmite_Container')
         | IsSpellChildOrVariantFromContext('VBT_Target_LifeDrain')
         | IsSpellChildOrVariantFromContext('VBT_Projectile_LifeDrain')
        -- Some dude's homebrew
         | IsSpellChildOrVariantFromContext('Target_Smite_Pitiless')
        -- Blackguard smites by Xarara
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_ENDARKENING')                         -- Endarkening (Subclass unique)
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_ENDARKENING_TRUE')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_VENOMOUS')                            -- Venomous
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_VENOMOUS_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CHILLING')                            -- Chilling
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CHILLING_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_SILENCING')                           -- Silencing
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_SILENCING_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CAUSTIC')                             -- Caustic
         | IsSpellChildOrVariantFromContext('PROJECTILE_SMITE_CAUSTIC')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CAUSTIC_BLOOD')
         | IsSpellChildOrVariantFromContext('PROJECTILE_SMITE_CAUSTIC_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLINDING_SICKNESS')       -- Necrotising
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_FILTH_FEVER')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_FLESH_ROT')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_MINDFIRE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_SEIZURE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_SLIMY_DOOM')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_BLINDING_SICKNESS')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_FILTH_FEVER')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_FLESH_ROT')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_MINDFIRE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_SEIZURE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_SLIMY_DOOM')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_VAMPIRIC')                            -- Vampiric
end

-- ==================================== Way of Four Elements Monk

function Goon_IsWayOfFourElementsSpell()
    return IsSpellChildOrVariantFromContext('Projectile_BladeOfTheRime')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Acid_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Cold_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Fire_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Lightning_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Poison_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ChromaticOrb_Thunder_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_FangsOfTheFireSnake')
         | IsSpellChildOrVariantFromContext('Projectile_Fireball_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_RayOfFrost_Monk')
         | IsSpellChildOrVariantFromContext('Projectile_ScorchingRay_Monk')
         | IsSpellChildOrVariantFromContext('Shout_Fly_Monk')
         | IsSpellChildOrVariantFromContext('Shout_GaseousForm_Monk')
         | IsSpellChildOrVariantFromContext('Shout_PassWithoutTrace_Monk')
         | IsSpellChildOrVariantFromContext('Target_Darkness_Monk')
         | IsSpellChildOrVariantFromContext('Target_Darkvision_Monk')
         | IsSpellChildOrVariantFromContext('Target_FistOfUnbrokenAir')
         | IsSpellChildOrVariantFromContext('Target_HoldPerson_Monk')
         | IsSpellChildOrVariantFromContext('Target_Shatter_Monk')
         | IsSpellChildOrVariantFromContext('Target_ShockingGrasp_Monk')
         | IsSpellChildOrVariantFromContext('Target_ShapeTheFlowingRiver_IceBlock') -- Doesn't grant MARTIAL_ARTS_BONUS_UNARMED_STRIKE in vanilla.
         | IsSpellChildOrVariantFromContext('Target_Silence_Monk')
         | IsSpellChildOrVariantFromContext('Target_WaterWhip')
         | IsSpellChildOrVariantFromContext('Target_WaterWhip_Pull')
         | IsSpellChildOrVariantFromContext('Target_WaterWhip_Prone')
         | IsSpellChildOrVariantFromContext('Zone_BurningHands_Monk')
         | IsSpellChildOrVariantFromContext('Zone_GustOfWind_Monk')
         | IsSpellChildOrVariantFromContext('Zone_Thunderwave_Monk')
         | IsSpellChildOrVariantFromContext('Zone_ConeOfCold_Monk') -- Expansion
         | IsSpellChildOrVariantFromContext('Target_Stoneskin_Monk')
         | IsSpellChildOrVariantFromContext('Wall_WallOfFire_Monk')
         | IsSpellChildOrVariantFromContext('Wall_WallOfStone_Monk')
end

-- ==================================== Common Actions

function Goon_IsDisengageSpell()
    return IsSpellChildOrVariantFromContext('Shout_Disengage')
         | IsSpellChildOrVariantFromContext('Shout_Disengage_BonusAction')
         | IsSpellChildOrVariantFromContext('Shout_Disengage_CunningAction')
         | IsSpellChildOrVariantFromContext('Shout_Disengage_StepOfTheWind')
         | IsSpellChildOrVariantFromContext('Shout_BootsOfSpeed')
         | IsSpellChildOrVariantFromContext('Target_DrunkenTechnique')
         | IsSpellChildOrVariantFromContext('Shout_LOW_Dolor_Disengage')
         | IsSpellChildOrVariantFromContext('Shout_Disengage_Goblin')
         | IsSpellChildOrVariantFromContext('Shout_GOB_WolfPens_Disengage_GoblinKid')
         | IsSpellChildOrVariantFromContext('Shout_ShadowStealth_Meazel')
         | IsSpellChildOrVariantFromContext('SYR_Shout_Disengage_BonusAction_DruidQoL')
end

-- One says condition the other says status gonna kms no cap
-- TODO: Psuedo status group for Disengage specifically?
-- TODO: Give them all SG_Ignore_AOO?
function Goon_HasDisengageCondition()
    return HasAnyStatus({ 'SG_Disengage', 'DISENGAGE', 'DRUNKEN_TECHNIQUE', 'CLICK_HEELS', 'HALF_MOVEMENT', 'SHADOW_STEALTH' }, {}, {})
end

function Goon_HasDashStatus()
    return HasAnyStatus({ 'DASH', 'DASH_STACKED', 'DASH_STACKED_2', 'GOON_DASH_STACKED_3', 'GOON_DASH_STACKED_4', 'GOON_DASH_STACKED_5', 'GOON_DASH_STACKED_6', 'GOON_DASH_STACKED_7', 'GOON_DASH_STACKED_8', 'GOON_DASH_STACKED_9' }, {}, {})
end

function Goon_IsDashSpellCategory()
    return SpellCategoryIs(SpellCategory.Dash)
end

function Goon_IsJumpSpellCategory()
    return SpellCategoryIs(SpellCategory.Jump)
end

-- ==================================== Debuffs

function Goon_IsBanishSpell()
    return IsSpellChildOrVariantFromContext('Target_Banishment')
         | IsSpellChildOrVariantFromContext('Target_Smite_Banishing')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Banishing')
         | IsSpellChildOrVariantFromContext('Projectile_ArcaneShot_BanishingArrow')
         | IsSpellChildOrVariantFromContext('Target_DispelEvilAndGood_Dismissal')
         | IsSpellChildOrVariantFromContext('Shout_WildMagic_Banish')
         | IsSpellChildOrVariantFromContext('OO_Shout_BanishUnholy')
end

-- TODO: Pseudo status group.
function Goon_HasSlowStatus()
    return HasAnyStatus({ 'SLOW', 'TAD_BLACK_HOLE_SLOW', 'MF_BLACK_HOLE_SLOW', 'END_NETHERBRAIN_SLOW', 'LOW_BG_SLOW_WARNING1', 'KICKUP_BOAR', 'LOW_BG_SLOW_WARNING2', 'ABJURE_ENEMY_SLOW', 'LOW_OSKARSBELOVED_SKULL_SLOW' }, {}, {})
end

-- ==================================== Spells that aren't spells
-- HasFunctor(StatsFunctorType.RegainHitPoints)

function Goon_IsHealingActionGrantedBySpell()
    return Goon_IsAuraOfVitality()
end

function Goon_IsAuraOfVitality()
    return IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate')
         | IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate_4')
         | IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate_5')
         | IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate_6')
         | IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate_7')
         | IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate_8')
         | IsSpellChildOrVariantFromContext('Target_AuraOfVitality_Activate_9')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate_4')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate_5')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate_6')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate_7')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate_8')
         | IsSpellChildOrVariantFromContext('Goon_Target_AuraOfVitality_Activate_9')
end

-- War Caster not included. You cast a spell instead of taking an AoO, the spell cast is not an AoO inherently.
function Goon_IsAttackOfOpportunity()
    return IsSpellChildOrVariantFromContext('Target_Sentinel_AttackOfOpportunity')
         | IsSpellChildOrVariantFromContext('Goon_Target_MainHandAttack_AoO')
         | IsSpellChildOrVariantFromContext('Goon_Target_OffhandAttack_AoO')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_MainHandAttack_AoO')
         | IsSpellChildOrVariantFromContext('Goon_Projectile_OffhandAttack_AoO')
         | IsSpellChildOrVariantFromContext('Goon_Target_UnarmedAttack_AoO')
         | IsSpellChildOrVariantFromContext('Goon_Target_Shove_AoO')
         | IsSpellChildOrVariantFromContext('Goon_Target_Grapple_AoO')
end

-- ==================================== Conditional damage cantrips and spells
-- Some spells have conditional damage, this conditional damage may even be the spell's declared "DamageType" and yet the character may not be able to have the spell deal said damage. The conditional nature of these spells is not accounted for in some circumstances, the below functions are intended to try and make additional damage mirror what the character is actually dealing.
-- Disallows spells with a DamageType but no DealDamage functors from triggering things improperly
-- TODO: Add support for more conditional spells from mods. E.g. Homebrew Blade Cantrips by zx10rx.
-- TODO: Allow statuses from spells such as Booming Blades conditional explosion damage to function? (case by case basis and circumstantially really annoying to implement I imagine.)
-- TODO: Replace every instance of "HasFunctor(StatsFunctorType.DealDamage)" with this function, and include it wherever "SpellDamageTypeIs" is called, barring exceptions. (Is this really necessary? What am I on about here...)

function Goon_IsSpellDealingFunctorDamage(source, target, ignoreFunctorCheck, ignoreConditionalCheck)
    source = source or context.Source
    target = target or context.Target

    if ignoreFunctorCheck and ignoreConditionalCheck then
        return true
    elseif ignoreFunctorCheck then
        return ~Goon_IsConditionalDamageSpell() | Goon_IsConditionalDamageSpellEligible(source, target)
    elseif ignoreConditionalCheck then
        return HasFunctor(StatsFunctorType.DealDamage)
    else
        return HasFunctor(StatsFunctorType.DealDamage)
             & (~Goon_IsConditionalDamageSpell() | Goon_IsConditionalDamageSpellEligible(source, target))
    end
end

function Goon_IsConditionalDamageSpellEligible(source, target)
    source = source or context.Source
    target = target or context.Target

    return ~Goon_IsSpellWithoutDamageType(source, target) & IsSpell() & ~IsCantrip()
         & SpellId('BroWhereEvenAreTheConditionalDamageSpellsFR')
         | Goon_IsConditionalDamageCantripEligible(source, target)
end

function Goon_IsConditionalDamageCantripEligible(source, target)
    source = source or context.Source
    target = target or context.Target

    return ~Goon_IsSpellWithoutDamageType(source, target) & IsCantrip()
         & (Goon_IsBoomingBladeSpell()          & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsGreenFlameBladeSpell()        & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsSparkingBladeSpell()          & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsBloodlettingBiteSpell()       & HasHPPercentageWithoutTemporaryHPEqualOrLessThan(50, target)
         | Goon_IsMisfortunesMarkSpell()        & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsRimeStrikeSpell()             & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsRighteousIncitementSpell()    & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsSpellShatteringStrikeSpell()  & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsVortexDartSpell()             & Goon_CharacterLevelEqualToOrGreaterThan_5(source)
         | Goon_IsWardensRebukeSpell()          & Goon_CharacterLevelEqualToOrGreaterThan_5(source))
end

function Goon_IsConditionalDamageSpell()
    return Goon_IsConditionalDamageCantrip()
end

function Goon_IsConditionalDamageCantrip()
    return Goon_IsBoomingBladeSpell()
         | Goon_IsGreenFlameBladeSpell()
         | Goon_IsSparkingBladeSpell()
         | Goon_IsBloodlettingBiteSpell()
         | Goon_IsMisfortunesMarkSpell()
         | Goon_IsRimeStrikeSpell()
         | Goon_IsRighteousIncitementSpell()
         | Goon_IsSpellShatteringStrikeSpell()
         | Goon_IsVortexDartSpell()
         | Goon_IsWardensRebukeSpell()
end

function Goon_IsBoomingBladeSpell()
    return IsSpellChildOrVariantFromContext('Target_BoomingBlade')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_ClassSpell')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_5e')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_Default')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_SneakAttack')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Life')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Cold')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Fire')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Lightning')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Thunder')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Poison')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_MeleeWeapon')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Necrotic')
         | IsSpellChildOrVariantFromContext('Target_BoomingBlade_DivineStrike_Psychic')
         | IsSpellChildOrVariantFromContext('Target_SVMagus_BoomingBlade')
end

function Goon_IsGreenFlameBladeSpell()
    return IsSpellChildOrVariantFromContext('Target_GreenFlameBlade') 
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_Default')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_SneakAttack')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Life')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Cold')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Fire')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Lightning')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Thunder')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Poison')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_MeleeWeapon')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Necrotic')
         | IsSpellChildOrVariantFromContext('Target_GreenFlameBlade_DivineStrike_Psychic')
end

-- TODO: why do some of Celes' variants not do _Large?
-- Projectile_GreenFlameBlade_Explosion
-- Projectile_GreenFlameBlade_Explosion_Large

function Goon_IsSparkingBladeSpell()
    return IsSpellChildOrVariantFromContext('Target_Sparking_Blade')
