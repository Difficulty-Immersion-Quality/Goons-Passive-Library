-- Character size checks
function Goon_IsSize(size, target)
    target = target or context.Target
    return ConditionResult(target.Size ~= Size.None and target.Size.value == size.value)
end

function Goon_IsSizeGreaterThan(size, target)
    target = target or context.Target
    return ConditionResult(target.Size ~= Size.None and target.Size.value > size.value)
end

function Goon_IsSizeLessThan(size, target)
    target = target or context.Target
    return ConditionResult(target.Size ~= Size.None and target.Size.value < size.value)
end

function Goon_IsSizeGreaterThanOrEqual(size, target)
    target = target or context.Target
    return ConditionResult(target.Size ~= Size.None and target.Size.value >= size.value)
end

function Goon_IsSizeLessThanOrEqual(size, target)
    target = target or context.Target
    return ConditionResult(target.Size ~= Size.None and target.Size.value <= size.value)
end

-- Class level checks
function Goon_ClassLevelEquals(level, class, source)
    source = source or context.Source
    return ConditionResult(source.GetClassLevel(class) == level)
end

function Goon_ClassLevelGreaterThan(level, class, source)
    source = source or context.Source
    return ConditionResult(source.GetClassLevel(class) > level)
end

function Goon_ClassLevelLessThan(level, class, source)
    source = source or context.Source
    return ConditionResult(source.GetClassLevel(class) < level)
end

function Goon_ClassLevelGreaterThanOrEqual(level, class, source)
    source = source or context.Source
    return ConditionResult(source.GetClassLevel(class) >= level)
end

function Goon_ClassLevelLessThanOrEqual(level, class, source)
    source = source or context.Source
    return ConditionResult(source.GetClassLevel(class) <= level)
end

function Goon_IsClassLevelEqualOrBetween(value, value2, class, source)
    source = source or context.Source
    -- was missing class param; source was landing in the class arg of the sub-calls, GetClassLevel would get 0
    -- if the intent was character level rather than class level, swap these for Goon_CharacterLevelGreaterThanOrEqual / LessThanOrEqual instead
    return Goon_ClassLevelGreaterThanOrEqual(value, class, source) & Goon_ClassLevelLessThanOrEqual(value2, class, source)
end

