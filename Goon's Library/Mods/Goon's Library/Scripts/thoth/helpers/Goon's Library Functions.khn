-- ==================================== Weapon/armour equipped checks ====================================

function Goon_Dueling_Check(target)
    target = target or context.Target
    local hasNonVersatileWeapon = WieldingWeapon('Melee', false, true, target) & ~WieldingWeapon('Versatile', false, true, target) & ~WieldingWeapon('Twohanded', false, true, target) & ~WieldingWeapon('Melee', true, true, target)
    local hasVersatileWeapon = WieldingWeapon('Versatile', false, true, target) & WieldingWeapon('Melee', false, true, target) & HasShieldEquipped(target)
    return hasNonVersatileWeapon | hasVersatileWeapon
end

-- This is exact same as the vanilla DualWielder() khn function but putting this here for completeness
function Goon_DualWielding_Check(target)
    target = target or context.Target
    return WieldingWeapon('Melee', false, true, target) & WieldingWeapon('Melee', true, true, target)
end

function Goon_GreatWeapon_Check(target)
    target = target or context.Target
    local hasTwohandedWeapon = WieldingWeapon('Twohanded', false, true, target) & WieldingWeapon('Melee', false, true, target)
    local hasVersatileWeapon = WieldingWeapon('Versatile', false, true, target) & ~WieldingWeapon('Melee', true, true, target) & ~HasShieldEquipped(target)
    return hasTwohandedWeapon | hasVersatileWeapon
end

-- Use in conjunction with Goon_IsPolearm() check (which only checks the active weapon) to reasonably cover all polearm-wielding possibilities for NPCs at least
function Goon_Polearm_Check(target)
    target = target or context.Target
    return WieldingWeapon('Reach', false, true, target)
end

function Goon_Bow_Check(target)
    target = target or context.Target
    return WieldingWeapon('Ammunition', false, true, target)
end

function Goon_Crossbow_Check(target)
    target = target or context.Target
    return WieldingWeapon('Loading', false, true, target)
end

function Goon_HasLightArmor(target)
    target = target or context.Target
    local armor = GetActiveArmor(target)
    return IsOfProficiencyGroup("LightArmor", armor)
end

-- Alternative light armor check matching how it's checked in vanilla
function Goon_HasLightArmorAlt(target)
    target = target or context.Target
    local armor = GetActiveArmor(target)
    local hasLightArmor = armor.ArmorType == ArmorType.Padded or armor.ArmorType == ArmorType.Leather or armor.ArmorType == ArmorType.StuddedLeather
    return ConditionResult(hasLightArmor)
end

-- WearingArmor and HasShieldEquipped functions DGAF about you being in wildshape and count your equipment, unlike when using GetItemInEquipmentSlot where it doesn't work for wildshape.
function Goon_NotWearingArmorOrHasShieldEquipped(source)
    source = source or context.Source
    return (~WearingArmor(source) & ~HasShieldEquipped(source) | Goon_IsRestrictedPolymorphStatus(source)) 
         & Goon_IsNonHostilePolymorphStatus(source)
end

function Goon_NotWearingArmor(source)
    source = source or context.Source
    return (~WearingArmor(source) | Goon_IsRestrictedPolymorphStatus(source)) 
         & Goon_IsNonHostilePolymorphStatus(source)
end

function Goon_NotHasShieldEquipped(source)
    source = source or context.Source
    return (~HasShieldEquipped(source) | Goon_IsRestrictedPolymorphStatus(source)) 
         & Goon_IsNonHostilePolymorphStatus(source)
end

-- ==================================== Weapon enchant checks ====================================
-- HasAnyStatus(hasAnyStatuses, hasAllStatuses, hasNoneStatuses, target, source, ignoreDeletingStatuses)
-- Tagged(string tag, [Entity target])
-- TODO: Mainhand/offhand true/false arg

function Goon_IsSpellcastingModifierWeapon(source, weapon)
    source = source or context.Source
    weapon = weapon or GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)
    return HasAnyStatus({ 'SHILLELAGH', 'MAG_MELEE_CASTER_BOON', 'LHB_SEL_TASHASOTHERWORLDLYGUISE_MAGICWEAPON', 'MAG_MELEE_CASTER_BOON_SORROW', 'MAG_MELEE_CASTER_BOON_LATHANDER', 'GOON_SHADOW_BLADE_2', 'GOON_SHADOW_BLADE_3', 'GOON_SHADOW_BLADE_4', 'GOON_SHADOW_BLADE_5', 'GOON_SHADOW_BLADE_6', 'GOON_SHADOW_BLADE_7', 'GOON_SHADOW_BLADE_8', 'GOON_SHADOW_BLADE_9', 'GOON_FLAME_BLADE_MEPHISTOPHELES', 'GOON_FLAME_BLADE_2', 'GOON_FLAME_BLADE_3', 'GOON_FLAME_BLADE_4', 'GOON_FLAME_BLADE_5', 'GOON_FLAME_BLADE_6', 'GOON_FLAME_BLADE_7', 'GOON_FLAME_BLADE_8', 'GOON_FLAME_BLADE_9' }, {}, {}, weapon)
end

function Goon_IsIntelligenceModifierWeapon(source, weapon)
    source = source or context.Source
    weapon = weapon or GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)
    return HasAnyStatus({ 'GOON_WHERETHEWIZARDBLADEENCHANTFRHARRYPOTTERGANGSHIT' }, {}, {}, weapon)
end

function Goon_IsWisdomModifierWeapon(source, weapon)
    source = source or context.Source
    weapon = weapon or GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)
    return HasAnyStatus({ 'FourEle_Attuned' }, {}, {}, weapon)
end

function Goon_IsCharismaModifierWeapon(source, weapon)
    source = source or context.Source
    weapon = weapon or GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)
    return HasAnyStatus({ 'PACT_BLADE', 'HEXBLADE_BIND', 'CAT_SCHOLAR_ARMAMENT' }, {}, {}, weapon) | Tagged('PACT_OF_THE_BLADE', weapon)
end

function Goon_IsShadowBladeWeapon(source, weapon)
    source = source or context.Source
    weapon = weapon or GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)
    return HasAnyStatus({ 'SHADOWBLADE_TECHNICAL', 'GOON_KNIFEOFTHEUNDERMOUNTAINKING_WEAPON_TECHNICAL', 'GOON_SHADOWRENDINGDAGGER_WEAPON_TECHNICAL', 'GOON_JUSTICIARSSCIMITAR_WEAPON_TECHNICAL' }, {}, {}, weapon)
end

-- ==================================== Weapon enchant checks - Cahoot's revision

function Goon_AttackingWithSpellcastingModifierWeapon(source)
    source = source or context.Source
    return HasStatus('SHILLELAGH', GetAttackWeapon(source))
         | HasStatus('MAG_MELEE_CASTER_BOON', GetAttackWeapon(source))
         | HasStatus('LHB_SEL_TASHASOTHERWORLDLYGUISE_MAGICWEAPON', GetAttackWeapon(source))
         | HasStatus('MAG_MELEE_CASTER_BOON_SORROW', GetAttackWeapon(source))
         | HasStatus('MAG_MELEE_CASTER_BOON_LATHANDER', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_2', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_3', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_4', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_5', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_6', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_7', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_8', GetAttackWeapon(source))
         | HasStatus('GOON_SHADOW_BLADE_9', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_MEPHISTOPHELES', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_2', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_3', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_4', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_5', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_6', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_7', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_8', GetAttackWeapon(source))
         | HasStatus('GOON_FLAME_BLADE_9', GetAttackWeapon(source))
end

-- function Goon_AttackingWithIntelligenceModifierWeapon()
--     return HasAnyStatus({}, {}, {})
-- end

function Goon_AttackingWithWisdomModifierWeapon(source)
    source = source or context.Source
    return HasStatus('FourEle_Attuned', GetAttackWeapon(source))
end

function Goon_AttackingWithCharismaModifierWeapon(source)
    source = source or context.Source
    return HasStatus('HEXBLADE_BIND', GetAttackWeapon(source)) 
         | HasStatus('PACT_BLADE', GetAttackWeapon(source)) 
         | HasStatus('CAT_SCHOLAR_ARMAMENT', GetAttackWeapon(source))
end

-- ==================================== Weapon enchant checks - Trying something different
-- TODO: Need to be able to just get them in the most generic way possible, not checking for attack weapon.
-- GetActiveWeapon
-- GetItemInEquipmentSlot
-- MartialArts_DextrousUnarmedAttacks in DIQ Misc Patches needs this shit bad.
-- Might need additional custom statuses for my Shadow Blade/Flame Blade edits.
-- TODO: 

function Goon_IsPactWeapon()
    return StatusId('PACT_BLADE') | StatusId('HEXBLADE_BIND') | Tagged('PACT_OF_THE_BLADE')
end

function Goon_HasPactWeapon(target)
    target = target or context.Target
    return HasStatus('PACT_BLADE', target) | HasStatus('HEXBLADE_BIND', target) | Tagged('PACT_OF_THE_BLADE', target)
end

-- ==================================== Weapon enchant checks - Bound weapons only
-- TODO: Add support for any custom statuses that fit the bill
-- TODO: Replace all instances where all 3 of these are called with the functions

function Goon_IsBoundWeaponStatus()
    return (StatusId('WEAPON_BOND') | StatusId('PACT_BLADE') | StatusId('HEXBLADE_BIND'))
end

function Goon_HasBoundWeaponStatus(target)
    target = target or context.Target
    return (HasStatus('WEAPON_BOND', target) | HasStatus('PACT_BLADE', target) | HasStatus('HEXBLADE_BIND', target))
end

function Goon_AttackingWithBoundWeapon(source)
    source = source or context.Source
    return HasStatus('WEAPON_BOND', GetAttackWeapon(source))
         | HasStatus('PACT_BLADE', GetAttackWeapon(source))
         | HasStatus('HEXBLADE_BIND', GetAttackWeapon(source))
end

-- ==================================== Weapon enchant checks - Vanilla Flame Blade
-- Don't need to add my custom conditions here, it's already doing an attack roll in Goon's Spell Overhaul.
-- TODO: Condense, arg for hand check.

function Goon_IsFlameBladeSpellAttack(source)
    source = source or context.Source
    return Goon_IsFlameBladeSpellAttack_Mainhand(source) | Goon_IsFlameBladeSpellAttack_Offhand(source)
end

function Goon_IsFlameBladeSpellAttack_Mainhand(source)
    source = source or context.Source
    return IsMeleeSpellAttack()
         & (HasStatus('FLAME_BLADE', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_3', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_4', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_5', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_6', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_7', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_8', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_9', GetActiveWeapon(source, true))
         | HasStatus('FLAME_BLADE_MEPHISTOPHELES', GetActiveWeapon(source, true)))
end

function Goon_IsFlameBladeSpellAttack_Offhand(source)
    source = source or context.Source
    return IsMeleeSpellAttack()
         & (HasStatus('FLAME_BLADE', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_3', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_4', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_5', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_6', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_7', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_8', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_9', GetActiveWeapon(source, false))
         | HasStatus('FLAME_BLADE_MEPHISTOPHELES', GetActiveWeapon(source, false)))
end

-- ==================================== Weapon enchant checks - IsDexterityGreaterThanStrength()
-- TODO: The tag checks after return are too binary for my liking, but that's pretty low prio because I'm unsure any of those even exist in DIQ rn. Though, I bet Sumra has some stuff...
-- TODO: arg for hand check.

function Goon_IsCastingModifierGreaterThanDexterity_IsDexterityGreaterThanStrength(source, mainHandWeapon)
    source = source or context.Source
    mainHandWeapon = mainHandWeapon or GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)

    local IsConstitutionGreaterThanDexterity            = ConditionResult(false)
    local IsSpellcastingModifierGreaterThanDexterity    = ConditionResult(false)
    local IsIntelligenceGreaterThanDexterity            = ConditionResult(false)
    local IsWisdomGreaterThanDexterity                  = ConditionResult(false)
    local IsCharismaGreaterThanDexterity                = ConditionResult(false)

    IsConstitutionGreaterThanDexterity = (HasPassive('LLBoulder_DextrousUnarmedAttacks', source) | Tagged('BOULDER', source))
        -- & ConditionResult(source.Constitution >= source.Strength)
        & ConditionResult(source.Constitution >= source.Dexterity)

    if mainHandWeapon.IsValid then
        IsSpellcastingModifierGreaterThanDexterity = Goon_IsSpellcastingModifierWeapon(source, mainHandWeapon)
            -- & ConditionResult(Goon_GetHighestAbilityValue({'Intelligence','Wisdom','Charisma'}, source) >= source.Strength)
            & ConditionResult(Goon_GetHighestAbilityValue({'Intelligence','Wisdom','Charisma'}, source) >= source.Dexterity)

        IsIntelligenceGreaterThanDexterity = Goon_IsIntelligenceModifierWeapon(source, mainHandWeapon)
            -- & ConditionResult(source.Intelligence >= source.Strength)
            & ConditionResult(source.Intelligence >= source.Dexterity)

        IsWisdomGreaterThanDexterity = Goon_IsWisdomModifierWeapon(source, mainHandWeapon)
            -- & ConditionResult(source.Wisdom >= source.Strength)
            & ConditionResult(source.Wisdom >= source.Dexterity)

        IsCharismaGreaterThanDexterity = Goon_IsCharismaModifierWeapon(source, mainHandWeapon)
            -- & ConditionResult(source.Charisma >= source.Strength)
            & ConditionResult(source.Charisma >= source.Dexterity)
    end

    return IsDexterityGreaterThanStrength()
        & ~Tagged('VESSEL', source)
        & ~HasStatus('ASTRALSELF_EMPOWERED_WISDOM', source)
        & ~IsConstitutionGreaterThanDexterity
        & ~IsSpellcastingModifierGreaterThanDexterity
        & ~IsIntelligenceGreaterThanDexterity
        & ~IsWisdomGreaterThanDexterity
        & ~IsCharismaGreaterThanDexterity
end

-- ==================================== Tag piles ====================================
-- Mod support: FIREARM_MOD = Artificer
-- NOTE: These will not work for boosts using context.HitDescription.ThrownObject. But maybe declaring that context in the functions themselves will work.
-- HasAnyTags only works in stats and not khn, but unlike Tagged it works with context.HitDescription.ThrownObject, despite only having one use case in the whole fucking game.

-- isMeleeWeapon:   true = melee,   false = ranged,     nil = either (True/False filters out shields, unless isShield == true)
-- isOffhand:       true = offhand, false = main hand,  nil = either
-- isMartialWeapon: true = martial, false = simple,     nil = either (True/False filters out shields, unless isShield == true)
-- isShield:        true = shield,  false = weapon,     nil = either (True overwrites weapons)
function Goon_HasWeaponEquipped(isMeleeWeapon, isOffhand, isMartialWeapon, isShield, source)
    source = source or context.Source

    local proficiencyGroup = proficiencyGroup
    if isMartialWeapon == true then
        proficiencyGroup = 'MartialWeapons'
    elseif isMartialWeapon == false then
        proficiencyGroup = 'SimpleWeapons'
    end

    local meleeMainHand     = GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, source)
    local meleeOffHand      = GetItemInEquipmentSlot(EquipmentSlot.MeleeOffHand, source)
    local rangedMainHand    = GetItemInEquipmentSlot(EquipmentSlot.RangedMainHand, source)
    local rangedOffHand     = GetItemInEquipmentSlot(EquipmentSlot.RangedOffHand, source)

    local meleeMainHandCheck    = meleeMainHand.IsValid and HasWeaponProperty(WeaponProperties.Melee, meleeMainHand).Result
    local meleeOffHandCheck     = meleeOffHand.IsValid and HasWeaponProperty(WeaponProperties.Melee, meleeOffHand).Result
    local rangedMainHandCheck   = rangedMainHand.IsValid and HasWeaponProperty(WeaponProperties.Ammunition, rangedMainHand).Result
    local rangedOffHandCheck    = rangedOffHand.IsValid and HasWeaponProperty(WeaponProperties.Ammunition, rangedOffHand).Result

    local meleeMainHandShield   = meleeMainHand.IsValid and IsOfProficiencyGroup('Shields', meleeMainHand).Result
    local meleeOffHandShield    = meleeOffHand.IsValid and IsOfProficiencyGroup('Shields', meleeOffHand).Result
    local rangedMainHandShield  = rangedMainHand.IsValid and IsOfProficiencyGroup('Shields', rangedMainHand).Result
    local rangedOffHandShield   = rangedOffHand.IsValid and IsOfProficiencyGroup('Shields', rangedOffHand).Result

    if isShield == true then
        meleeMainHandCheck  = meleeMainHandShield
        meleeOffHandCheck   = meleeOffHandShield
        rangedMainHandCheck = rangedMainHandShield
        rangedOffHandCheck  = rangedOffHandShield
    elseif isShield == false then
        meleeMainHandCheck  = meleeMainHandCheck and not meleeMainHandShield
        meleeOffHandCheck   = meleeOffHandCheck and not meleeOffHandShield
        rangedMainHandCheck = rangedMainHandCheck and not rangedMainHandShield
        rangedOffHandCheck  = rangedOffHandCheck and not rangedOffHandShield
    elseif isMeleeWeapon == nil then
        meleeMainHandCheck  = meleeMainHandCheck or meleeMainHandShield
        meleeOffHandCheck   = meleeOffHandCheck or meleeOffHandShield
        rangedMainHandCheck = rangedMainHandCheck or rangedMainHandShield
        rangedOffHandCheck  = rangedOffHandCheck or rangedOffHandShield
    end

    if proficiencyGroup and isShield ~= true then
        meleeMainHandCheck  = meleeMainHandCheck and IsOfProficiencyGroup(proficiencyGroup, meleeMainHand).Result
        meleeOffHandCheck   = meleeOffHandCheck and IsOfProficiencyGroup(proficiencyGroup, meleeOffHand).Result
        rangedMainHandCheck = rangedMainHandCheck and IsOfProficiencyGroup(proficiencyGroup, rangedMainHand).Result
        rangedOffHandCheck  = rangedOffHandCheck and IsOfProficiencyGroup(proficiencyGroup, rangedOffHand).Result
    end

    local mainHandCheck = meleeMainHandCheck or rangedMainHandCheck
    local offHandCheck  = meleeOffHandCheck or rangedOffHandCheck
    local meleeCheck    = meleeMainHandCheck or meleeOffHandCheck
    local rangedCheck   = rangedMainHandCheck or rangedOffHandCheck

    if isMeleeWeapon == true then
        if isOffhand == true then
            return ConditionResult(meleeOffHandCheck)
        elseif isOffhand == false then
            return ConditionResult(meleeMainHandCheck)
        else
            return ConditionResult(meleeCheck)
        end
    elseif isMeleeWeapon == false then
        if isOffhand == true then
            return ConditionResult(rangedOffHandCheck)
        elseif isOffhand == false then
            return ConditionResult(rangedMainHandCheck)
        else
            return ConditionResult(rangedCheck)
        end
    elseif isOffhand == true then
        return ConditionResult(offHandCheck)
    elseif isOffhand == false then
        return ConditionResult(mainHandCheck)
    else
        return ConditionResult(mainHandCheck or offHandCheck)
    end
end

-- TODO: Disarm shields?
function Goon_WieldingWeapon(target)
	target = target or context.Target
	return WieldingWeapon('Melee', true, false, target)
		 | WieldingWeapon('Melee', false, false, target)
		 | WieldingWeapon('Ammunition', true, false, target)
		 | WieldingWeapon('Ammunition', false, false, target)
end

-- TODO: What context do I want?
function Goon_IsWeapon()
    return Goon_IsMeleeWeapon()
         | Goon_IsRangedWeapon()
end

-- Just use HasWeaponProperty(WeaponProperties.Melee, context.HitDescription.ThrownObject) instead
function Goon_IsMeleeWeapon()
    return Tagged('WPN_BATTLEAXE')
         | Tagged('WPN_CLUB')
         | Tagged('WPN_DAGGER')
         | Tagged('WPN_DART')
         | Tagged('WPN_FLAIL')
         | Tagged('WPN_GLAIVE')
         | Tagged('WPN_GREATAXE')
         | Tagged('WPN_GREATSWORD')
         | Tagged('WPN_HALBERD')
         | Tagged('WPN_HANDAXE')
         | Tagged('WPN_JAVELIN')
         | Tagged('WPN_LIGHT_HAMMER')
         | Tagged('WPN_LONGSWORD')
         | Tagged('WPN_MACE')
         | Tagged('WPN_MAUL')
         | Tagged('WPN_MORNINGSTAR')
         | Tagged('WPN_PIKE')
         | Tagged('WPN_STAVE')
         | Tagged('WPN_RAPIER')
         | Tagged('WPN_SCIMITAR')
         | Tagged('WPN_SHORTSWORD')
         | Tagged('WPN_SICKLE')
         | Tagged('WPN_SPEAR')
         | Tagged('WPN_TRIDENT')
         | Tagged('WPN_WAR_PICK')
         | Tagged('WPN_WARHAMMER')
end

-- Just use HasWeaponProperty(WeaponProperties.Ammunition, context.HitDescription.ThrownObject) instead
function Goon_IsRangedWeapon()
    return Tagged('WPN_HAND_CROSSBOW')
         | Tagged('WPN_HEAVY_CROSSBOW')
         | Tagged('WPN_LIGHT_CROSSBOW')
         | Tagged('WPN_LONGBOW')
         | Tagged('WPN_SHORTBOW')
         | Tagged('WPN_SLING')
         | Tagged('FIREARM_MOD')
end

function Goon_IsThrownWeapon()
    return HasWeaponProperty(WeaponProperties.Thrown)
end

function Goon_IsThrownWeaponThrow(weapon)
    weapon = weapon or context.HitDescription.ThrownObject
    return HasWeaponProperty(WeaponProperties.Thrown, weapon)
end

function Goon_IsMeleeNotThrownWeapon()
    return HasWeaponProperty(WeaponProperties.Melee) & ~HasWeaponProperty(WeaponProperties.Thrown)
end

function Goon_IsMeleeNotThrownWeaponThrow(weapon)
    weapon = weapon or context.HitDescription.ThrownObject
    return HasWeaponProperty(WeaponProperties.Melee, weapon) & ~HasWeaponProperty(WeaponProperties.Thrown, weapon)
end

function Goon_IsAxe()
    return Tagged('WPN_BATTLEAXE')
         | Tagged('WPN_GREATAXE')
         | Tagged('WPN_HANDAXE')
end

function Goon_IsPolearm()
    return Tagged('WPN_GLAIVE')
         | Tagged('WPN_HALBERD')
         | Tagged('WPN_JAVELIN')
         | Tagged('WPN_PIKE')
         | Tagged('WPN_STAVE')
         | Tagged('WPN_SPEAR')
         | Tagged('WPN_TRIDENT')
end

function Goon_IsSword()
    return Tagged('WPN_GREATSWORD')
         | Tagged('WPN_LONGSWORD')
         | Tagged('WPN_RAPIER')
         | Tagged('WPN_SCIMITAR')
         | Tagged('WPN_SHORTSWORD')
end

function Goon_IsHammer()
    return Tagged('WPN_LIGHT_HAMMER')
         | Tagged('WPN_MAUL')
         | Tagged('WPN_WARHAMMER')
end

-- ==================================== Magical unarmed ====================================
-- Hunting down everything with the UnarmedMagicalProperty() boost.
-- Supports Expansion, 5e Spells, Blood Hunter, Veenab stuff, Mystic Expansion, Zephyr, Mizora's Rewards, Book of Druids, Dread Overlord
-- Note: UnarmedDamage*0 inserted into a DealDamage like so: DealDamage(2d10+UnarmedDamage*0,Slashing) gives full functionality while retaining static numbers or specific die sizes.
-- This shit below is cumbersome and far less dynamic by comparison, just do the above where appropriate.

function Goon_HasMagicalUnarmed(source)
    source = source or context.Source
    return Goon_IsWildshapeDruidPolymorph(source) & HasPassive('PrimalStrike', source)
         | HasPassive('KiEmpoweredStrikes', source)
         | Goon_HasMagicalUnarmed_Expansion(source)
         | Goon_HasMagicalUnarmed_BloodHunter(source)
         | Goon_HasMagicalUnarmed_Veenab(source)
         | HasPassive('InvestmentOfTheChainMaster_Familiar', source)
         | HasPassive('SVZephyr_TapestryTatteringArms', source)
         | HasPassive('Passive_Mystic_FlawlessTechnique', source)
         | HasPassive('MightySummonMagicalUnarmed', source)
         | HasAnyStatus({ 'DREADOVERLORD_NECROTICBLADE_UNARMED' }, {}, {}, source)
end

function Goon_HasMagicalUnarmed_Expansion(source)
    source = source or context.Source
    return HasPassive('ExceptionalTraining_EXP', source)
         | HasAnyStatus({ 'ALTER_SELF_BLUDGEONING_WEAPON', 'ALTER_SELF_SLASHING_WEAPON', 'ALTER_SELF_PIERCING_WEAPON' }, {}, {}, source)
end

function Goon_HasMagicalUnarmed_BloodHunter(source)
    source = source or context.Source
    return HasPassive('ImprovedPredatoryStrikes', source)
         | HasPassive('ImprovedPredatoryStrikes11', source)
end

function Goon_HasMagicalUnarmed_Veenab(source)
    source = source or context.Source
    return HasPassive('VBT_ARM_UnarmedProwessWraps_MagicalStrikes_1', source)
         | HasPassive('VBT_ARM_UnarmedProwessWraps_MagicalStrikes_2', source)
         | HasPassive('VBT_ARM_UnarmedProwessWraps_MagicalStrikes_3', source)
end

-- ==================================== Condition errors ====================================
-- inlined result variable; .Result: ~ returns ConditionResult, error overload needs a plain bool

function Goon_HasUnbrokenOath(source)
    source = source or context.Source
    return ConditionResult((~Tagged('OATHBREAKER', source)).Result, { ConditionError("Goon_HasBrokenOath") })
end

-- TODO: Could be set up generic like, have SE apply a status and use it universally.
function Goon_HasAttackedOrCast_FirstVampireWarlock(source)
    source = source or context.Source
    return ConditionResult(HasAnyStatus({ 'GOON_DRAIN_LIFE_TECHNICAL', 'GOON_DRAIN_LIFE_TECHNICAL_ETERNAL_NIGHT' }, {}, {}, source).Result, { ConditionError("Goon_HasAttackedOrCast") })
end

-- ==================================== Druid and Polymorph stuff ====================================
-- TODO: Hunt down everything relevant.
-- Check for any and all druid forms, only druid forms and not stinky disguise self etc.
-- Mod support: Circle of Storm Chasers and the custom Circle of Stars.
-- TODO: Maybe remove declaring entities and leave it blank like condition status checks above.
-- TODO: Refactor, do functions for StatusId as well as HasStatus. Do status checks for Slayer and Myrmidons, instead of just tag.
-- TODO: Support for that one druid class mod?
-- 'HAG_DISGUISE','HAG_DISGUISE_PIG','HAG_DISGUISE_SHEEP'

function Goon_IsDruidWildshapeOrStatus(source)
    source = source or context.Source
    return Goon_IsWildshapeDruidPolymorph(source) | Goon_IsMyrmidonDruidPolymorph(source) | Goon_IsHumanoidDruidPolymorph(source)
end

function Goon_IsDruidWildshape(source)
    source = source or context.Source
    return Goon_IsWildshapeDruidPolymorph(source) | Goon_IsMyrmidonDruidPolymorph(source)
end

function Goon_IsRestrictedPolymorphStatus(source)
    source = source or context.Source
    return Goon_IsWildshapeDruidPolymorph(source) | Goon_IsMyrmidonDruidPolymorph(source) | Tagged('SLAYER', source)
end

function Goon_IsUnrestrictedPolymorphStatus(source)
    source = source or context.Source
    return (Goon_IsHumanoidDruidPolymorph(source) | Goon_IsOtherPolymorph(source)) & (~Goon_IsRestrictedPolymorphStatus(source) & Goon_IsNonHostilePolymorphStatus(source))
end

-- TODO: How would I go about filtering sources of unwilling polymorphs for a custom ImmutableForm? Pseudo status group?
function Goon_IsNonHostilePolymorphStatus(source)
    source = source or context.Source
    return ~Tagged('POLYMORPHED_UNWILLING', source)
end

-- ==================================== Polymorph clusters

function Goon_IsWildshapeDruidPolymorph(source)
    source = source or context.Source
    return HasAnyStatus({ 'SG_Polymorph_BeastShape' }, {}, {}, source)
end

function Goon_IsMyrmidonDruidPolymorph(source)
    source = source or context.Source
    return Tagged('MYRMIDON_AIR', source) | Tagged('MYRMIDON_EARTH', source) | Tagged('MYRMIDON_FIRE', source) | Tagged('MYRMIDON_WATER', source)
end

-- TODO: 'SYMBIOTIC_ENTITY' doesn't really fit the bill, but I feel like it would be fitting for BG3.
-- TODO: DWE_BM_POLYMORPHED_CONCENTRATION what this for exactly?
function Goon_IsHumanoidDruidPolymorph(source)
    source = source or context.Source
    return HasAnyStatus({ 'WILDSHAPE_STARRY_ARCHER_PLAYER', 'WILDSHAPE_STARRY_CHALICE_PLAYER', 'WILDSHAPE_STARRY_DRAGON_PLAYER', 'STARRY_FORM_ARCHER', 'STARRY_FORM_CHALICE', 'STARRY_FORM_DRAGON', 'STORM_SHIFTER', 'DWE_BM_POLYMORPHED_CONCENTRATION' }, {}, {}, source)
end

function Goon_IsOtherPolymorph(source)
    source = source or context.Source
    return HasAnyStatus({ 'SG_Disguise', 'SG_Doppelganger', 'WYR_GORTASH_GORTANE' }, {}, {}, source) | Tagged('MINDFLAYER', source)
end

-- ==================================== Surface check stuff ====================================

function Goon_CreateSurfaceSpellCheck(source)
    source = source or context.Source
    return ~HasStatus('GOON_SURFACE_CHECK', source) | HasStatus('GOON_ITEMORDEAD_CHECK', source)
end

function Goon_IsItemOrDead(target)
    target = target or context.Target
    return Item(target) | Dead(target)
end

-- ==================================== Blindness, Darkness, Illusions, Invisibility & Sneaking ====================================
-- Credit to DrKekyll, Celes and Sumradagnoth for all messing with this craziness before I did.

function Goon_CanSourceSeeTarget(swapContext, swapThirdParty, ignoreDistance, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if HasStatus('SG_Blinded', source_).Result and not
       Goon_CanIgnoreBlindness(false, false, ignoreDistance, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
        return ConditionResult(false)
    end

    if HasStatus('SG_Invisible', target_).Result and not
       Goon_CanSeeInvisible(false, false, ignoreDistance, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
        return ConditionResult(false)
    end

    if HasStatus('SNEAKING', target_).Result and not
       Goon_CanSeeSneaking(source_, target_).Result then
        return ConditionResult(false)
    end

    -- TODO: Goon_CanIgnoreIllusions() is going to need some other shit, probably worth referencing Necrobroker.

    return ConditionResult(true)
end

-- ====================================
-- "Blindsense: Starting at 14th level, if you are able to hear, you are aware of the location of any hidden or invisible creature within 10 feet of you."
-- This is not granting the ability to actually see or ignore anything, but in the context of BG3 it might as well?

function Goon_CanIgnoreBlindness(swapContext, swapThirdParty, ignoreDistance, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if not IsImmuneToStatus('SG_Blinded', source_).Result then
        if not (HasPassive('Blindsense', source_).Result and not
               (HasPassive('Deafness', source_).Result or HasStatus('SG_Deafened', source_).Result)) then
            if not HasPassive('FightingStyle_BlindFighting', source_).Result then
                return ConditionResult(false)
            end
        end
    end
    if ignoreDistance then
        return ConditionResult(true)
    end
    return Goon_DistanceCheck(3, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition)
end

function Goon_CanIgnoreIllusions(swapContext, swapThirdParty, ignoreDistance, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if Tagged('BLINDSIGHT', source_).Result or
       HasPassive('WitchSight', source_).Result then -- TODO: Same/similar distance check as TRUESIGHT?
        return ConditionResult(true)
    end

    if HasStatus('TRUESIGHT', source_).Result then
        if ignoreDistance then
            return ConditionResult(true)
        end
        if Goon_DistanceCheck(36.5, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
            return ConditionResult(true)
        end
    end

    if HasPassive('FightingStyle_BlindFighting', source_).Result or
       (HasPassive('Blindsense', source_).Result and not
       (HasPassive('Deafness', source_).Result or HasStatus('SG_Deafened', source_).Result)) then
        if ignoreDistance then
            return ConditionResult(true)
        end
        if Goon_DistanceCheck(3, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
            return ConditionResult(true)
        end
    end

    return ConditionResult(false)
end

function Goon_CanSeeInvisible(swapContext, swapThirdParty, ignoreDistance, source, target, observer, sourcePosition, targetPosition, observerPosition)
    source = source or context.Source
    target = target or context.Target
    observer = observer or context.Observer
    sourcePosition = sourcePosition or context.SourcePosition
    targetPosition = targetPosition or context.TargetPosition
    observerPosition = observerPosition or context.ObserverPosition

    local isSwapped = swapContext
    local isThirdParty = observer.IsValid and observer ~= source and observer ~= target
    local isThirdPartyFallback = isThirdParty and swapThirdParty == nil and not target.IsValid

    if isSwapped == nil and observer.IsValid and observer == target and observer ~= source then
        isSwapped = Self(observer, target).Result
    end

    local source_ = source
    local target_ = target
    local sourcePosition_ = sourcePosition
    local targetPosition_ = targetPosition

    if isSwapped == true then
        source_ = target
        target_ = source
        sourcePosition_ = targetPosition
        targetPosition_ = sourcePosition
    elseif swapThirdParty == true then
        source_ = observer
        target_ = source
        sourcePosition_ = observerPosition
        targetPosition_ = sourcePosition
    elseif isThirdPartyFallback then
        target_ = observer
        targetPosition_ = observerPosition
    end

    if Tagged('BLINDSIGHT', source_).Result or
       HasPassive('WitchSight', source_).Result then -- TODO: Same/similar distance check as TRUESIGHT?
        return ConditionResult(true)
    end

    if HasStatus('MIND_SPIKE_OWNER', source_).Result and
       HasStatus('MIND_SPIKE', target_, source_).Result then
        return ConditionResult(true)
    end

    if HasStatus('TRUESIGHT', source_).Result then
        if ignoreDistance then
            return ConditionResult(true)
        end
        if Goon_DistanceCheck(36.5, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
            return ConditionResult(true)
        end
    end

    if HasAnyStatus({ 'SEE_INVISIBILITY', 'MAG_SEE_INVISIBILITY_HIDDEN_IGNORE_RESTING', 'TRUESIGHT_BOON_OF_THE_NIGHT_SPIRIT' }, {}, {}, source_).Result or
       HasPassive('AllSeeingEye', source_).Result then
        if ignoreDistance then
            return ConditionResult(true)
        end
        if Goon_DistanceCheck(18.5, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
            return ConditionResult(true)
        end
    end

    if HasPassive('FightingStyle_BlindFighting', source_).Result or
       (HasPassive('Blindsense', source_).Result and not
       (HasPassive('Deafness', source_).Result or HasStatus('SG_Deafened', source_).Result)) then
        if ignoreDistance then
            return ConditionResult(true)
        end
        if Goon_DistanceCheck(3, false, false, false, false, source_, target_, observer, sourcePosition_, targetPosition_, observerPosition).Result then
            return ConditionResult(true)
        end
    end

    return ConditionResult(false)
end

function Goon_CanSeeSneaking(source, target)
    source = source or context.Source
    target = target or context.Target

    if HasStatus('MIND_SPIKE_OWNER', source).Result and
       HasStatus('MIND_SPIKE', target, source).Result then
        return ConditionResult(true)
    end

    return ConditionResult(false)
end

-- ==================================== 

function Goon_IsInvisibleSeen(target)
    target = target or context.Target
    return HasStatus('GOON_INVISIBLE_SEEN', target)
         | HasStatus('GOON_INVISIBLE_MAGEHAND_SEEN', target)
         | HasStatus('GOON_INVISIBILITY_SEEN', target)
         | HasStatus('GOON_ONE_WITH_SHADOWS_SEEN', target)
         | HasStatus('GOON_POTION_OF_INVISIBILITY_SEEN', target)
         | HasStatus('GOON_CLOAK_OF_SHADOWS_SEEN', target)
         | HasStatus('GOON_CLOAK_OF_SHADOWS_MONK_SEEN', target)
         | HasStatus('GOON_UMBRAL_CLOAK_SEEN', target)
         | HasStatus('GOON_GREATER_INVISIBILITY_SEEN', target)
         | HasStatus('GOON_SHADOWBLEND_SEEN', target)
         | HasStatus('GOON_INVISIBILITY_SHADARKAI_GLOOMWEAVER_SEEN', target)
         | HasStatus('GOON_HIDE_IN_PLAIN_SIGHT_SEEN', target)
         | HasStatus('GOON_MISTY_ESCAPE_INVISIBLE_SEEN', target)
         | HasStatus('GOON_INVISIBILITY_PANTHER_SEEN', target)
         | HasStatus('GOON_SHROUD_SELF_SEEN', target)
         | HasStatus('GOON_SUPREME_SNEAK_SEEN', target)
         | HasStatus('GOON_MAG_INVISIBLE_WEAPON_SEEN', target)
         | HasStatus('GOON_LOW_POLTERGEIST_INVISIBLE_SEEN', target)
         | HasStatus('GOON_SHADOW_WALKER_SEEN', target)
         | HasStatus('GOON_EMPTY_BODY_SEEN', target)
end

