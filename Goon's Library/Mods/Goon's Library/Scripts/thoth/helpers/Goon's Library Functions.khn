-- Check for ability used in attack roll
function Goon_AttackAbility(ability)
    return IsAttack() & ConditionResult(context.HitDescription.AttackAbility == ability)
end

-- TODO: Not sure we can dynamically return the attack ability like this SHILLELAGH
-- e.g. 8 + source.ProficiencyBonus + Goon_GetAttackAbilityModifier(source)
function Goon_GetAttackAbilityModifier(source, attackAbility)
    source = source or context.Source
    attackAbility = attackAbility or context.HitDescription.AttackAbility

    if attackAbility == Ability.Strength then
        return GetModifier(source.Strength)
    elseif attackAbility == Ability.Dexterity then
        return GetModifier(source.Dexterity)
    elseif attackAbility == Ability.Constitution then
        return GetModifier(source.Constitution)
    elseif attackAbility == Ability.Intelligence then
        return GetModifier(source.Intelligence)
    elseif attackAbility == Ability.Wisdom then
        return GetModifier(source.Wisdom)
    elseif attackAbility == Ability.Charisma then
        return GetModifier(source.Charisma)
    end

    return 0
end

-- Check for magical weapon properties on attacking weapon
function Goon_AttackWeaponIsMagical(source)
    source = source or context.Source
    return HasWeaponProperty(WeaponProperties.Magical, GetAttackWeapon(source))
end

-- Disguise Self check
function Goon_IsDisguiseSelfSpell()
    return IsSpellChildOrVariantFromContext('Shout_DisguiseSelf')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Tiefling_Male')  
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Tiefling_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Drow_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Drow_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Human_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Human_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Githyanki_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Githyanki_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Dwarf_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Dwarf_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Elf_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Elf_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_HalfElf_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_HalfElf_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Halfling_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Halfling_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Dragonborn_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Dragonborn_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_HalfOrc_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_HalfOrc_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Gnome_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Gnome_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Human_Strong_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Human_Strong_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Drow_Strong_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Drow_Strong_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Elf_Strong_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Elf_Strong_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_HalfElf_Strong_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_HalfElf_Strong_Female')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Tiefling_Strong_Male')
         | IsSpellChildOrVariantFromContext('Shout_DisguiseSelf_Tiefling_Strong_Female')
end

-- Surface checks
function Goon_IsInWaterSurface(target)
    target = target or context.Target
    return InSurface('SurfaceBlood', target)
         | InSurface('SurfaceBloodElectrified', target)
         | InSurface('SurfaceBloodFrozen', target)
         | InSurface('SurfaceWater', target)
         | InSurface('SurfaceWaterElectrified', target)
         | InSurface('SurfaceWaterFrozen', target)
         | InSurface('SurfaceDeepWater', target)
         | InSurface('SurfaceDeepWaterRunning', target)
         | InSurface('Sewer', target)
end

function Goon_IsInFreezableSurface(target)
    target = target or context.Target
    return InSurface('SurfaceWater', target)
         | InSurface('SurfaceWaterElectrified', target)
         | InSurface('SurfaceBlood', target)
         | InSurface('SurfaceAlcohol', target)
         | InSurface('SurfaceAcid', target)
end

function Goon_IsInSlipperySurface(target)
    target = target or context.Target
    return InSurface('SurfaceWaterFrozen', target)
         | InSurface('SurfaceGreaseFrozen', target)
         | InSurface('SurfaceBloodFrozen', target)
         | InSurface('SurfaceGrease', target)
end

function Goon_IsInLiquidSurface(target)
    target = target or context.Target
    return InSurface('SurfaceBlood', target)
         | InSurface('SurfaceBloodElectrified', target)
         | InSurface('SurfaceBloodFrozen', target)
         | InSurface('SurfaceWater', target)
         | InSurface('SurfaceWaterElectrified', target)
         | InSurface('SurfaceWaterFrozen', target)
         | InSurface('SurfaceDeepWater', target)
         | InSurface('SurfaceDeepWaterRunning', target)
         | InSurface('Sewer', target)
         | InSurface('SurfaceAlcohol', target)
         | InSurface('SurfaceOil', target)
end

-- ==================================== BIG BRAIN FUNCTIONS ====================================

-- ==================================== String Lookups
-- Conditions created by JuuM that do string lookups that can be used for better upcast checking

-- JM_HasStringInSpellId('Spell1','Spell2')
-- Original name: function JM_HasStringInSpellId(...)
function Goon_HasStringInSpellId(...)
    local strings = { ... }
    local spellId = context.SpellModificationDescription.SpellId

    if spellId ~= "" then
        for _, v in ipairs(strings) do
            if string.find(spellId, v) then
                return ConditionResult(true)
            end
        end
    end
    return ConditionResult(false)
end

-- JM_SpellOrUpcastOf('Spell1','Spell2')
-- Original name: function JM_SpellOrUpcastOf(...)
function Goon_SpellOrUpcastOf(...)
    local spells = { ... }
    local spellLevel = context.HitDescription.SpellLevel
    local spellPowerLevel = context.HitDescription.SpellPowerLevel

    for _, v in ipairs(spells) do
        local spell = v
        if spellPowerLevel ~= spellLevel then
            spell = spell .. string.format("_%i", spellPowerLevel)
        end
        if SpellId(spell).Result then
            return ConditionResult(true)
        end
    end
    return ConditionResult(false)
end

-- ==================================== Get Highest Ability
-- Credit to JuuM: Returns the highest ability checked because... 
-- "But no way to get the observers spellcasting ability from khonsu unfortunately" - joow

function Goon_GetHighestAbility(abilities, source)
    source = source or context.Source
    local highestValue = 0
    local highestAbility = abilities[1]

    --will return first ability if tie
    for _,ability in ipairs(abilities) do
        if source[ability] > highestValue then
            highestValue = source[ability]
            highestAbility = Ability[ability]
        end
    end
    return highestAbility
end

